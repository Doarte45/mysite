---
import { Image } from "astro:assets";
import BaseHead from "../layouts/BaseHead.astro";
import CompareBar from "./CompareBar.astro";
import { cv, type Education } from "../data/cv.ts";
import mePhoto from "../assets/me.jpg";

export interface Props {
  /** Show the before/after design switcher (comparison route only). */
  compare?: boolean;
}
const { compare = false } = Astro.props;

const nameParts = cv.name.split(" ");
const firstName = nameParts[0] ?? cv.name;
const lastName = nameParts.slice(1).join(" ");

const base = import.meta.env.BASE_URL;
const resumeHref = `${base}/resume.pdf`.replace(/\/+/g, "/");
const siteUrl = new URL(base, Astro.site ?? Astro.url.origin).toString();

const emailLink = cv.contact.find((c) => c.href.startsWith("mailto:"));
const email = emailLink?.value;
const linkedin = cv.contact.find((c) => /linkedin/i.test(c.label));
const location = cv.contact.find((c) => /location/i.test(c.label));
const languages = cv.skills.find((g) => /language/i.test(g.heading));
const techSkills = cv.skills.filter((g) => g !== languages);

const personLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: cv.name,
  jobTitle: cv.role,
  url: siteUrl,
  ...(email && { email: `mailto:${email}` }),
  sameAs: cv.contact.filter((c) => c.href.startsWith("http") && c.label !== "Location").map((c) => c.href),
  alumniOf: cv.education.map((e) => ({ "@type": "EducationalOrganization", name: e.institution })),
};

// Network names lead; plain-English aliases sit beside them for recruiters.
const sections = [
  { id: "hops", name: "HOP_HISTORY", alias: "work experience", shape: "square" },
  { id: "missions", name: "MISSION_LOG", alias: "projects", shape: "square" },
  { id: "creds", name: "CRED_CHAIN", alias: "certifications", shape: "square" },
  { id: "training", name: "TRAINING_DATA", alias: "education", shape: "square" },
  { id: "stack", name: "SECURITY_STACK", alias: "skills", shape: "circle" },
  { id: "uplink", name: "UPLINK_PROTOCOL", alias: "contact", shape: "triangle" },
] as const;
const sec = Object.fromEntries(sections.map((s) => [s.id, s])) as Record<(typeof sections)[number]["id"], (typeof sections)[number]>;

// Summary → hero "open to" roles + an About block that doesn't repeat the hero.
const sentences = (cv.summary.match(/[^.!?]+(?:[.!?](?=\s|$))+/g)?.map((t) => t.trim()) ?? [cv.summary]).filter(Boolean);
const seekingSentence = sentences.find((t) => /^seeking\b/i.test(t));
// cv.json written by the current sync-cv always carries targetRoles; older files don't.
// When present, trust the extracted site fields; otherwise fall back to parsing the prose.
const synced = cv.targetRoles !== undefined;
const parsedRoles =
  seekingSentence
    ?.replace(/^seeking\s+/i, "")
    .replace(/\s+roles?\.?$/i, "")
    .split(/,\s*(?:or\s+|and\s+)?|\s+or\s+/)
    .map((r) => r.trim())
    .filter(Boolean) ?? [];
const targetRoles = synced ? [...(cv.targetRoles ?? [])] : parsedRoles;
const aboutSentences = sentences.filter((t, i) => t !== seekingSentence && !(i === 0 && /available/i.test(t)));

const escapeHtml = (t: string) =>
  t.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
const METRIC = /(~?\d[\d.]*%|\$\d[\d.]*(?:\/session)?|\d+\+?\s(?:hours|hands-on labs)|\d+-session|\bzero sessions\b|\bsix simultaneously active faults\b)/gi;
const emph = (t: string) => escapeHtml(t).replace(METRIC, "<strong>$1</strong>");

// Headline numbers for the featured project ("… rate of ~97%", "$0.81/session", "50-session").
const extractStats = (lines: readonly string[] = []) => {
  const out: { value: string; label: string }[] = [];
  for (const l of lines) {
    for (const m of l.matchAll(/\b([a-z][a-z -]{2,60}?)\s+of\s+(~?\$?\d[\d.]*%?)(\/[a-z]+)?/gi)) {
      const label = ((m[1] ?? "") + (m[3] ? ` per ${m[3].slice(1)}` : "")).replace(/^((achieved|an?|and|at|the|with)\s+)+/i, "");
      out.push({ value: m[2] ?? "", label: label.charAt(0).toUpperCase() + label.slice(1) });
    }
    const n = l.match(/\b(\d+)-session\b/i);
    if (n?.[1]) out.push({ value: n[1], label: "Sessions run" });
  }
  return out.slice(0, 4);
};

const BULLET_CAP = 3;
const PROJECT_CAP = 3;

const abbr = (inst: string) => inst.match(/\(([^)]+)\)\s*$/)?.[1] ?? inst;
const credentials = [
  ...cv.education.slice(0, 1).map((e) => ({ k: "DEGREE", v: `${e.degree.split(/,|\s+[–-]\s+/)[0]} · ${abbr(e.institution)}` })),
  ...(cv.certifications.length
    ? [{ k: "CERTIFIED", v: cv.certifications.map((c) => c.name.replace(/\s*Certification$/i, "")).join(" · ") }]
    : []),
];

const LEVEL = /^(.*?)\s*\((basic|intermediate|advanced|native|fluent)\)$/i;
const splitLevel = (item: string) => {
  const m = item.match(LEVEL);
  const name = ((m ? m[1] : item) ?? item).trim();
  return { name: name.charAt(0).toUpperCase() + name.slice(1), level: m?.[2]?.toLowerCase() };
};

const eduGroups = [
  ...cv.education.reduce((m, e) => m.set(e.institution, [...(m.get(e.institution) ?? []), e]), new Map<string, Education[]>()),
];

const relocation = synced ? cv.relocation : cv.location.match(/relocation\s*[-–—:]\s*([^)]+)/i)?.[1]?.trim();
// Old cv.json files predate the availability field; keep the previous wording for them.
const availability = synced ? cv.availability : "Immediately · full-time";

// Featured project: the one sync-cv flagged; for older files, the first project.
const featuredIndex = synced ? cv.projects.findIndex((p) => p.featured) : cv.projects.length ? 0 : -1;
const orderedProjects = [...cv.projects].sort((a, b) => Number(b === cv.projects[featuredIndex]) - Number(a === cv.projects[featuredIndex]));
const projectStats = (p: (typeof cv.projects)[number]) => (synced ? [...(p.metrics ?? [])] : extractStats(p.highlights));
const githubUser = cv.projects.map((pr) => pr.url?.match(/github\.com\/([^/]+)/i)?.[1]).find(Boolean);
const projectHref = (url: string) => (url.startsWith("http") ? url : `https://${url}`);
const prettyUrl = (url: string) => url.replace(/^https?:\/\//, "").replace(/\/$/, "");
const has: Record<(typeof sections)[number]["id"], boolean> = {
  hops: cv.experience.length > 0,
  missions: cv.projects.length > 0,
  creds: cv.certifications.length > 0,
  training: cv.education.length > 0,
  stack: techSkills.length > 0,
  uplink: true,
};
const periodParts = (p: string) => p.split(/\s+[–—-]\s+/);
---

<html lang="en">
  <head>
    <BaseHead title={`${cv.name} — Cybersecurity Engineer`} description={`${cv.name}, ${cv.role}. ${cv.tagline}`} />
    {compare && <meta name="robots" content="noindex" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("v3-theme");
          var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          document.documentElement.dataset.v3Theme = stored || (prefersDark ? "dark" : "light");
        } catch (e) {}
      })();
    </script>
  </head>
  <body class:list={["v3", { "has-compare": compare }]}>
    <a class="skip-link" href="#main">Skip to content</a>

    <div class="network-lines" aria-hidden="true">
      <svg width="100%" height="100%">
        <line class="net-line net-line--strong" x1="10%" y1="10%" x2="90%" y2="90%" />
        <line class="net-line net-line--strong" x1="90%" y1="10%" x2="10%" y2="90%" />
        <line class="net-line net-line--faint" x1="50%" y1="0%" x2="50%" y2="100%" />
      </svg>
    </div>

    <header class="topbar">
      <div class="topbar__inner">
        <a class="brand" href="#top" aria-label="Back to top">
          <span class="brand__prompt">~/</span>{firstName.toLowerCase()}<span class="brand__cursor" aria-hidden="true"></span>
        </a>
        <nav class="route-table" aria-label="Sections">
          {sections.filter((s) => has[s.id]).map((s) => (
            <a href={`#${s.id}`} data-nav={s.id} title={s.alias}>{s.name}</a>
          ))}
        </nav>
        <a class="topbar__cv" href={resumeHref} target="_blank" rel="noopener">[ CV ↓ ]</a>
        <button class="theme-toggle" type="button" aria-label="Toggle dark mode" aria-pressed="false" data-theme-toggle>
          <svg class="icon icon--sun" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="4" fill="currentColor" />
            <g stroke="currentColor" stroke-width="1.8" stroke-linecap="square">
              <line x1="12" y1="2" x2="12" y2="5" /><line x1="12" y1="19" x2="12" y2="22" />
              <line x1="2" y1="12" x2="5" y2="12" /><line x1="19" y1="12" x2="22" y2="12" />
              <line x1="4.5" y1="4.5" x2="6.5" y2="6.5" /><line x1="17.5" y1="17.5" x2="19.5" y2="19.5" />
              <line x1="4.5" y1="19.5" x2="6.5" y2="17.5" /><line x1="17.5" y1="6.5" x2="19.5" y2="4.5" />
            </g>
          </svg>
          <svg class="icon icon--moon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20 14.5A8 8 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5z" fill="currentColor" />
          </svg>
        </button>
      </div>
    </header>

    <main id="main">
      <!-- ============ HERO ============ -->
      <section class="hero" id="top" aria-label="Introduction">
        <div class="hero__text">
          <p class="node-label">
            <span class="node-label__node">NODE_AUTH: 10.0.0.2{availability && <span class="node-label__sep"> //</span>}</span>
            {availability && (
              <>
                <span class="status"><span class="status__led" aria-hidden="true"></span>STATUS: AVAILABLE</span>
                <span class="node-label__dim">&nbsp;· {availability}</span>
              </>
            )}
          </p>
          <h1>{firstName}{lastName && (<><br />{lastName}</>)}</h1>
          <p class="tagline">{cv.role}</p>
          {cv.tagline && <p class="hero__lead">{/[.!?]$/.test(cv.tagline.trim()) ? cv.tagline.trim() : `${cv.tagline.trim()}.`}</p>}

          {targetRoles.length > 0 && (
            <p class="open-to">
              <span class="network-tag">OPEN_TO</span>
              <span class="open-to__roles">
                {targetRoles.map((r, i) => (<>{i > 0 && <span class="slash" aria-hidden="true"> / </span>}<span>{r}</span></>))}
              </span>
            </p>
          )}

          <div class="cta-row">
            <a class="bracket-btn bracket-btn--solid" href={resumeHref} target="_blank" rel="noopener">
              <span class="bracket-btn__b">[</span>DOWNLOAD_CV.PDF<span class="bracket-btn__arrow">↓</span><span class="bracket-btn__b">]</span>
            </a>
            {emailLink && (
              <a class="bracket-btn" href={emailLink.href}><span class="bracket-btn__b">[</span>EMAIL<span class="bracket-btn__b">]</span></a>
            )}
            {linkedin && (
              <a class="bracket-btn" href={linkedin.href} target="_blank" rel="noopener"><span class="bracket-btn__b">[</span>LINKEDIN<span class="bracket-btn__arrow">↗</span><span class="bracket-btn__b">]</span></a>
            )}
          </div>
        </div>

        <figure class="portrait">
          <svg class="topo" viewBox="0 0 400 520" aria-hidden="true">
            <g class="topo__links">
              <path id="l1" d="M22 120 L22 36 L378 36" />
              <path id="l3" d="M378 36 L378 260" /><path id="l4" d="M378 260 L378 464" />
              <path id="l5" d="M22 120 L22 390" /><path id="l6" d="M22 390 L22 464 L378 464" />
            </g>
            <g class="topo__packets">
              <circle r="3"><animateMotion dur="6s" repeatCount="indefinite"><mpath href="#l1" /></animateMotion></circle>
              <circle r="3"><animateMotion dur="6s" repeatCount="indefinite"><mpath href="#l5" /></animateMotion></circle>
              <circle r="3"><animateMotion dur="5s" repeatCount="indefinite"><mpath href="#l3" /></animateMotion></circle>
              <circle r="3"><animateMotion dur="7s" repeatCount="indefinite"><mpath href="#l6" /></animateMotion></circle>
            </g>
            <g class="topo__nodes">
              <g transform="translate(22 120)"><rect x="-19" y="-11" width="38" height="22" rx="5" /><text y="4">R1</text></g>
              <g transform="translate(378 36)"><rect x="-19" y="-11" width="38" height="22" rx="5" /><text y="4">R2</text></g>
              <g transform="translate(378 260)"><rect x="-19" y="-11" width="38" height="22" rx="5" /><text y="4">R3</text></g>
              <g transform="translate(22 390)"><rect x="-22" y="-11" width="44" height="22" rx="5" /><text y="4">DMZ</text></g>
              <g transform="translate(378 464)"><rect x="-22" y="-11" width="44" height="22" rx="5" /><text y="4">SOC</text></g>
            </g>
          </svg>
          <div class="portrait__frame">
            <span class="corner corner--tl" aria-hidden="true"></span>
            <span class="corner corner--tr" aria-hidden="true"></span>
            <span class="corner corner--bl" aria-hidden="true"></span>
            <span class="corner corner--br" aria-hidden="true"></span>
            <Image
              src={mePhoto}
              alt={`Portrait of ${cv.name}`}
              widths={[240, 360, 480, 720]}
              sizes="(max-width: 760px) 120px, 280px"
              width={720}
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </figure>

        <dl class="facts">
          {location && (<div class="fact"><dt>LOCATION_</dt><dd>{location.value}</dd></div>)}
          {relocation && (<div class="fact"><dt>RELOCATION_</dt><dd>Open to {relocation}</dd></div>)}
          {availability && (<div class="fact"><dt>START_</dt><dd>{availability}</dd></div>)}
          {languages && (<div class="fact"><dt>LANGUAGES_</dt><dd>{languages.items.join(" · ")}</dd></div>)}
        </dl>
      </section>

      <!-- ============ ABOUT ============ -->
      {aboutSentences.length > 0 && (
      <section class="about" aria-labelledby="about-h">
        <div class="about__main">
          <h2 class="network-tag" id="about-h">PACKET_INSPECTION <span class="network-tag__alias">// about me</span></h2>
          <p class="about__text">{aboutSentences.join(" ")}</p>
        </div>
        <dl class="kv">
          {credentials.map((c) => (<div class="kv__row"><dt>{c.k}_</dt><dd>{c.v}</dd></div>))}
        </dl>
      </section>
      )}

      <!-- ============ EXPERIENCE ============ -->
      {has.hops && (
      <section class="section" id="hops" aria-labelledby="hops-h">
        <div class="section-head">
          <span class={`shape shape--${sec.hops.shape}`} aria-hidden="true"></span>
          <h2 id="hops-h">{sec.hops.name}</h2>
          <span class="section-head__alias">// {sec.hops.alias}</span>
        </div>
        <ol class="timeline">
          {cv.experience.map((exp) => (
            <li class="tl-item">
              <p class="tl-item__period">
                <span class="tl-item__src">SRC:</span>
                {periodParts(exp.period).map((part, j, all) => (<span class="nowrap">{part}{j < all.length - 1 ? " – " : ""}</span>))}
              </p>
              <div class="tl-item__body">
                <h3>{exp.role}</h3>
                <p class="company"><span class="company__name">{exp.company}</span>{exp.location && (<> <span class="company__sep">·</span> {exp.location}</>)}</p>
                {exp.summary && <p class="desc">{exp.summary}</p>}
                <ul class="hl-list" data-cap={BULLET_CAP}>
                  {exp.highlights.map((h) => <li set:html={emph(h)} />)}
                </ul>
                {exp.highlights.length > BULLET_CAP && (
                  <button type="button" class="more" data-more hidden aria-expanded="false">
                    <span class="more__open">show {exp.highlights.length - BULLET_CAP} more</span><span class="more__close">show less</span>
                  </button>
                )}
              </div>
            </li>
          ))}
        </ol>
      </section>
      )}

      <!-- ============ PROJECTS ============ -->
      {has.missions && (
      <section class="section" id="missions" aria-labelledby="missions-h">
        <div class="section-head">
          <span class={`shape shape--${sec.missions.shape}`} aria-hidden="true"></span>
          <h2 id="missions-h">{sec.missions.name}</h2>
          <span class="section-head__alias">// {sec.missions.alias}</span>
        </div>
        <div class="missions">
          {orderedProjects.map((p, i) => {
            const featured = i === 0 && featuredIndex >= 0;
            const cap = featured ? PROJECT_CAP : 2;
            const stats = featured ? projectStats(p) : [];
            const title = p.url ? <a class="proj-link" href={projectHref(p.url)} target="_blank" rel="noopener">{p.name}</a> : p.name;
            return (
              <article class:list={["mission", { "mission--featured": featured }]}>
                <div class="mission__main">
                  {featured && <span class="network-tag">FEATURED_RESEARCH</span>}
                  <span class="year">REF: {p.year}</span>
                  <h3>{title}</h3>
                  <p class="company">{p.stack.join(" / ")}</p>
                  {p.description && <p class="desc">{p.description}</p>}
                  {p.highlights && (
                    <>
                      <ul class="hl-list" data-cap={cap}>{p.highlights.map((h) => <li set:html={emph(h)} />)}</ul>
                      {p.highlights.length > cap && (
                        <button type="button" class="more" data-more hidden aria-expanded="false">
                          <span class="more__open">show {p.highlights.length - cap} more</span><span class="more__close">show less</span>
                        </button>
                      )}
                    </>
                  )}
                  {p.url && !featured && (
                    <a class="mono-link" href={projectHref(p.url)} target="_blank" rel="noopener">{prettyUrl(p.url)} ↗</a>
                  )}
                </div>
                {featured && (
                  <aside class="mission__results" aria-label="Results">
                    {stats.length >= 2 && (
                      <>
                        <p class="results__label">RESULTS_</p>
                        <dl class="stats">
                          {stats.map((st) => (<div class="stat"><dt>{st.label}</dt><dd class:list={{ "stat__value--long": st.value.length > 7 }}>{st.value}</dd></div>))}
                        </dl>
                      </>
                    )}
                    {p.url && <a class="mono-link" href={projectHref(p.url)} target="_blank" rel="noopener">{prettyUrl(p.url)} ↗</a>}
                  </aside>
                )}
              </article>
            );
          })}
        </div>
      </section>
      )}

      <!-- ============ CERTS + EDUCATION ============ -->
      <div class:list={["split", { "split--single": !(has.creds && has.training) }]}>
      {has.creds && (
        <section class="section" id="creds" aria-labelledby="creds-h">
          <div class="section-head">
            <span class={`shape shape--${sec.creds.shape}`} aria-hidden="true"></span>
            <h2 id="creds-h">{sec.creds.name}</h2>
            <span class="section-head__alias">// {sec.creds.alias}</span>
          </div>
          <div class="entries">
            {cv.certifications.map((c) => {
              const verify = c.badgeId ? `https://www.credly.com/badges/${c.badgeId}` : undefined;
              return (
                <article class="entry">
                  <div class="entry__head">
                    <div>
                      <span class="year">{c.date}</span>
                      <h3>{c.name}</h3>
                      <p class="company">{c.issuer}</p>
                    </div>
                    {c.badgeImage && (verify ? (
                      <a class="badge" href={verify} target="_blank" rel="noopener noreferrer" title="Verify on Credly">
                        <img src={c.badgeImage} alt={`${c.name} badge — verify on Credly`} width="64" height="64" loading="lazy" />
                      </a>
                    ) : (
                      <span class="badge"><img src={c.badgeImage} alt={`${c.name} badge`} width="64" height="64" loading="lazy" /></span>
                    ))}
                  </div>
                  {c.detail && <p class="desc" set:html={emph(c.detail)} />}
                  {verify && <a class="mono-link" href={verify} target="_blank" rel="noopener noreferrer">VERIFY_CREDENTIAL ↗</a>}
                </article>
              );
            })}
          </div>
        </section>
      )}

      {has.training && (
        <section class="section" id="training" aria-labelledby="training-h">
          <div class="section-head">
            <span class={`shape shape--${sec.training.shape}`} aria-hidden="true"></span>
            <h2 id="training-h">{sec.training.name}</h2>
            <span class="section-head__alias">// {sec.training.alias}</span>
          </div>
          <div class="entries">
            {eduGroups.map(([institution, items]) => (
              <article class="entry">
                <p class="company company--school">{institution}</p>
                <ol class="degrees">
                  {items.map((e) => (
                    <li>
                      <span class="year">{e.period}</span>
                      <h3>{e.degree}</h3>
                      {e.detail && <p class="desc">{e.detail}</p>}
                    </li>
                  ))}
                </ol>
              </article>
            ))}
          </div>
        </section>
      )}
      </div>

      <!-- ============ SKILLS ============ -->
      {has.stack && (
      <section class="section" id="stack" aria-labelledby="stack-h">
        <div class="section-head">
          <span class={`shape shape--${sec.stack.shape}`} aria-hidden="true"></span>
          <h2 id="stack-h">{sec.stack.name}</h2>
          <span class="section-head__alias">// {sec.stack.alias}</span>
        </div>
        <dl class="stack">
          {techSkills.map((g) => (
            <div class="stack__row">
              <dt>{g.heading}</dt>
              <dd>
                {g.items.map((item, i) => {
                  const { name, level } = splitLevel(item);
                  return (
                    <>
                      {i > 0 && <span class="slash" aria-hidden="true"> / </span>}
                      <span class="skill">{name}{level && <span class="skill__level"> ({level})</span>}</span>
                    </>
                  );
                })}
              </dd>
            </div>
          ))}
        </dl>
      </section>
      )}

      <!-- ============ CONTACT ============ -->
      <section class="section" id="uplink" aria-labelledby="uplink-h">
        <div class="section-head">
          <span class={`shape shape--${sec.uplink.shape}`} aria-hidden="true"></span>
          <h2 id="uplink-h">{sec.uplink.name}</h2>
          <span class="section-head__alias">// {sec.uplink.alias}</span>
        </div>
        <div class="uplink">
          <div>
            <p class="uplink__lead">
              {targetRoles.length ? `Hiring for ${targetRoles.join(", ").replace(/, ([^,]*)$/, " or $1")}? Let's talk.` : "Let's talk."}
            </p>
            <div class="cta-row">
              {emailLink && (
