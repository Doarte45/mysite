    <script>
      const root = document.documentElement;
      const btn = document.querySelector("[data-theme-toggle]");
      function apply(theme: string) {
        root.dataset.v3Theme = theme;
        btn?.setAttribute("aria-pressed", String(theme === "dark"));
      }
      apply(root.dataset.v3Theme || "light");
      btn?.addEventListener("click", () => {
        const next = root.dataset.v3Theme === "dark" ? "light" : "dark";
        localStorage.setItem("v3-theme", next);
        apply(next);
      });

      // Collapse long bullet lists; the toggle sits after the list. Without JS every bullet stays visible.
      document.querySelectorAll<HTMLButtonElement>("[data-more]").forEach((btn) => {
        const list = btn.previousElementSibling as HTMLElement | null;
        const cap = Number(list?.dataset.cap);
        if (!list || !cap) return;
        const extras = [...list.children].slice(cap) as HTMLElement[];
        const set = (open: boolean) => {
          extras.forEach((li) => (li.hidden = !open));
          btn.setAttribute("aria-expanded", String(open));
        };
        set(false);
        btn.hidden = false;
        btn.addEventListener("click", () => set(btn.getAttribute("aria-expanded") !== "true"));
      });

      // Route-table scroll-spy.
      const links = new Map([...document.querySelectorAll<HTMLAnchorElement>("[data-nav]")].map((a) => [a.dataset.nav!, a]));
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            links.forEach((a) => a.removeAttribute("aria-current"));
            links.get(e.target.id)?.setAttribute("aria-current", "true");
          }
        },
        { rootMargin: "-40% 0px -55% 0px" },
      );
      links.forEach((_, id) => {
        const el = document.getElementById(id);
        if (el) io.observe(el);
      });
      const hero = document.getElementById("top");
      if (hero) io.observe(hero);
    </script>

