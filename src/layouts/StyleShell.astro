---
import BaseHead from "./BaseHead.astro";
import StyleSwitcher from "../components/StyleSwitcher.astro";
import { cv } from "../data/cv.ts";

export interface Props {
  slug: string;
  styleName: string;
  fonts: string; // Google Fonts css2 query, e.g. "family=IBM+Plex+Mono:wght@400;700"
  bodyClass: string;
}
const { slug, styleName, fonts, bodyClass } = Astro.props;
const fontsHref = `https://fonts.googleapis.com/css2?${fonts}&display=swap`;
---

<html lang="en">
  <head>
    <BaseHead
      title={`${cv.name} — ${styleName}`}
      description={`${cv.name}, ${cv.role}. ${cv.tagline}`}
    />
    <meta name="robots" content="noindex" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={fontsHref} rel="stylesheet" />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <StyleSwitcher current={slug} />
  </body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; }
  body { margin: 0; }
  .skip-link {
    position: fixed; top: 12px; left: 12px; z-index: 30000;
    padding: 0.5rem 0.9rem; background: #000; color: #fff;
    font: 700 0.8rem ui-monospace, monospace; text-decoration: none;
    transform: translateY(-200%); transition: transform 150ms;
  }
  .skip-link:focus-visible { transform: none; }
</style>
