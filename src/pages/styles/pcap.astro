---
import { Image } from "astro:assets";
import StyleShell from "../../layouts/StyleShell.astro";
import { cv } from "../../data/cv.ts";
import mePhoto from "../../assets/me.jpg";

const resume = `${import.meta.env.BASE_URL}/resume.pdf`.replace(/\/+/g, "/");

// Build a deterministic hex dump of the name for the hero decoration.
const bytes = Array.from(new TextEncoder().encode(`${cv.name} :: ${cv.role}`));
const hexRows: { off: string; hex: string; ascii: string }[] = [];
for (let i = 0; i < bytes.length; i += 16) {
  const chunk = bytes.slice(i, i + 16);
  hexRows.push({
    off: i.toString(16).padStart(4, "0"),
    hex: chunk.map((b) => b.toString(16).padStart(2, "0")).join(" "),
    ascii: chunk.map((b) => (b >= 32 && b < 127 ? String.fromCharCode(b) : ".")).join(""),
  });
}

type Frame = { proto: "TCP" | "TLS" | "HTTP" | "DNS" | "ARP" | "ICMP"; src: string; dst: string; info: string; len: number; detail?: string | undefined; list?: readonly string[] | undefined; link?: string | undefined };
let n = 0;
const frames: { title: string; rows: Frame[] }[] = [
  {
    title: "Experience",
    rows: cv.experience.map((e) => ({ proto: "TLS", src: e.company, dst: e.location, info: `${e.role}`, len: e.highlights.length, detail: `${e.period}${e.summary ? " — " + e.summary : ""}`, list: e.highlights })),
  },
  {
    title: "Projects",
    rows: cv.projects.map((p) => ({ proto: "HTTP", src: p.year, dst: p.stack.join(", "), info: p.name, len: (p.description ?? "").length + p.stack.length, detail: p.description, list: p.highlights, link: p.url ? (p.url.startsWith("http") ? p.url : `https://${p.url}`) : undefined })),
  },
  {
    title: "Education",
    rows: cv.education.map((e) => ({ proto: "DNS", src: e.institution, dst: e.period, info: e.degree, len: e.degree.length, detail: e.detail })),
  },
  {
    title: "Certifications",
    rows: cv.certifications.map((c) => ({ proto: "ARP", src: c.issuer, dst: c.date, info: c.name, len: c.name.length, detail: c.detail, link: c.badgeId ? `https://www.credly.com/badges/${c.badgeId}` : undefined })),
  },
];
---

<StyleShell
  slug="pcap"
  styleName="Packet Capture"
  fonts="family=Sora:wght@400;600;800&family=Fira+Code:wght@400;500;600"
  bodyClass="pcap"
>
  <header class="toolbar">
    <div class="toolbar__title">
      <span class="fin" aria-hidden="true"></span>
      <span>{cv.name.toLowerCase().replace(/\s+/g, "_")}.pcapng</span>
    </div>
    <label class="filter">
      <span class="filter__lbl">Apply a display filter</span>
      <span class="filter__box"><code>profile.role == "{cv.role}"</code><span class="filter__ok">✓</span></span>
    </label>
    <div class="toolbar__right">
      <span>Packets: {frames.reduce((a, f) => a + f.rows.length, 0)}</span>
      <span>Profile: Default</span>
    </div>
  </header>

  <main id="main" class="wrap">
    <!-- Hero: hex dump + identity -->
    <section class="hero">
      <div class="hero__left">
        <p class="eyebrow">Frame 0 · Capture header</p>
        <h1 class="name">{cv.name}</h1>
        <p class="role">{cv.role}</p>
        <p class="summary">{cv.summary}</p>
        <div class="actions">
          <a class="btn btn--primary" href={resume} target="_blank" rel="noopener">Export packet dissections ↓ PDF</a>
          {cv.contact.map((c) => <a class="btn" href={c.href}><span class="btn__k">{c.label}</span> {c.value}</a>)}
        </div>
      </div>
      <div class="hero__right">
        <div class="photo">
          <Image src={mePhoto} alt={`${cv.name} — portrait`} widths={[240, 480]} sizes="220px" width={480} loading="eager" />
        </div>
        <pre class="hex" aria-label="Hex dump of the operator name">{hexRows.map((r) => `${r.off}  ${r.hex.padEnd(47, " ")}  ${r.ascii}`).join("\n")}</pre>
      </div>
    </section>

    <!-- Packet list panes -->
    {frames.map((f) => (
      <section class="pane">
        <header class="pane__hd">
          <h2>{f.title}</h2>
          <span class="pane__count">{f.rows.length} frame{f.rows.length === 1 ? "" : "s"}</span>
        </header>
        <div class="tbl" role="table">
          <div class="tr tr--head" role="row">
            <span role="columnheader">No.</span><span role="columnheader">Protocol</span><span role="columnheader">Source</span><span role="columnheader">Destination</span><span role="columnheader">Length</span><span role="columnheader">Info</span>
          </div>
          {f.rows.map((r) => {
            n += 1;
            return (
              <details class={`frame frame--${r.proto.toLowerCase()}`} open={f.title === "Experience"}>
                <summary class="tr" role="row">
                  <span class="td td--no">{n}</span>
                  <span class="td td--proto">{r.proto}</span>
                  <span class="td td--src">{r.src}</span>
                  <span class="td td--dst">{r.dst}</span>
                  <span class="td td--len">{r.len}</span>
                  <span class="td td--info">{r.link ? <a href={r.link} target="_blank" rel="noopener noreferrer">{r.info} ↗</a> : r.info}</span>
                </summary>
                <div class="dissect">
                  <div class="dissect__tree">
                    <p class="dissect__line">▸ Frame {n}: {r.len} bytes on wire</p>
                    {r.detail && <p class="dissect__line dissect__line--2">▾ Payload: <span class="dissect__val">{r.detail}</span></p>}
                    {r.list && (
                      <ul class="dissect__list">
                        {r.list.map((h) => <li>{h}</li>)}
                      </ul>
                    )}
                  </div>
                </div>
              </details>
            );
          })}
        </div>
      </section>
    ))}

    <!-- Certification badge images -->
    {cv.certifications.some((c) => c.badgeImage) && (
      <section class="badges">
        {cv.certifications.filter((c) => c.badgeImage).map((c) => (
          <a class="badge" href={c.badgeId ? `https://www.credly.com/badges/${c.badgeId}` : undefined} target="_blank" rel="noopener noreferrer">
            <img src={c.badgeImage} alt={`${c.name} badge`} width="96" height="96" loading="lazy" />
            <span>{c.name}</span>
          </a>
        ))}
      </section>
    )}

    <!-- Skills as protocol hierarchy -->
    <section class="pane">
      <header class="pane__hd"><h2>Protocol Hierarchy · Skills</h2><span class="pane__count">{cv.skills.length} protocols</span></header>
      <div class="hier">
        {cv.skills.map((g) => (
          <div class="hier__group">
            <h3 class="hier__hd">▾ {g.heading}</h3>
            <ul class="hier__items">{g.items.map((s) => <li>{s}</li>)}</ul>
            <span class="hier__bar" style={`--w:${Math.min(100, g.items.length * 16)}%`} aria-hidden="true"></span>
          </div>
        ))}
      </div>
    </section>
  </main>

  <footer class="status">
    <span>● Ready to load or capture</span>
    <span>Packets: {n} · Displayed: {n} (100.0%)</span>
    <span>Profile: {cv.location}</span>
  </footer>

  <style is:global>
    body.pcap {
      --paper: #f6f7f9;
      --panel: #ffffff;
      --line: #d9dee7;
      --ink: #14181f;
      --muted: #5c677a;
      --blue: #1f5fd1;
      --tcp: #e7f0e8;   /* light green */
      --tls: #ebe3f5;   /* lavender */
      --http: #e4f5e2;  /* green */
      --dns: #dbe8ff;   /* blue */
      --arp: #fbf2d5;   /* yellow */
      --icmp: #fbe1df;  /* pink */
      --sans: "Sora", system-ui, sans-serif;
      --mono: "Fira Code", ui-monospace, monospace;
      background: var(--paper);
      color: var(--ink);
      font-family: var(--sans);
      line-height: 1.55;
      min-height: 100vh;
    }
    .pcap .toolbar {
      position: sticky; top: 0; z-index: 10; display: grid; grid-template-columns: auto 1fr auto; gap: 1.25rem; align-items: center;
      padding: 0.6rem 1.25rem; background: #fff; border-bottom: 1px solid var(--line); font-family: var(--mono); font-size: 0.75rem;
    }
    .pcap .toolbar__title { display: flex; align-items: center; gap: 0.6rem; font-weight: 600; }
    .pcap .fin { width: 14px; height: 14px; background: var(--blue); clip-path: polygon(0 100%, 50% 0, 100% 100%); }
    .pcap .filter { display: flex; align-items: center; gap: 0.6rem; min-width: 0; }
    .pcap .filter__lbl { color: var(--muted); white-space: nowrap; }
    .pcap .filter__box { flex: 1; min-width: 0; display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; padding: 0.35rem 0.6rem; background: #e6f6e4; border: 1px solid #a9d7a3; border-radius: 3px; overflow: hidden; }
    .pcap .filter__box code { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .pcap .filter__ok { color: #2a8c3b; font-weight: 700; }
    .pcap .toolbar__right { display: flex; gap: 1.25rem; color: var(--muted); }
    .pcap .wrap { max-width: 1280px; margin: 0 auto; padding: 2.5rem 1.25rem 7rem; display: grid; gap: 2rem; }

    .pcap .hero { display: grid; grid-template-columns: 1.2fr 1fr; gap: 2.5rem; align-items: start; padding: 1.5rem 0 2rem; border-bottom: 2px solid var(--ink); animation: fade 500ms ease both; }
    @keyframes fade { from { opacity: 0; transform: translateY(8px); } }
    .pcap .eyebrow { font-family: var(--mono); font-size: 0.72rem; color: var(--blue); letter-spacing: 0.08em; margin: 0 0 0.75rem; }
    .pcap .name { font-size: clamp(2.6rem, 6vw, 4.8rem); font-weight: 800; letter-spacing: -0.03em; line-height: 0.95; margin: 0 0 0.75rem; }
    .pcap .role { font-family: var(--mono); font-size: 0.9rem; color: var(--muted); margin: 0 0 1.25rem; }
    .pcap .summary { font-size: 1.05rem; max-width: 60ch; margin: 0 0 1.5rem; }
    .pcap .actions { display: flex; flex-wrap: wrap; gap: 0.6rem; }
    .pcap .btn { font-family: var(--mono); font-size: 0.75rem; padding: 0.55rem 0.85rem; border: 1px solid var(--line); background: #fff; color: var(--ink); text-decoration: none; border-radius: 3px; transition: border-color 120ms, box-shadow 120ms; overflow-wrap: anywhere; }
    .pcap .btn:hover { border-color: var(--blue); box-shadow: 0 2px 0 var(--blue); }
    .pcap .btn__k { color: var(--muted); }
    .pcap .btn--primary { background: var(--ink); color: #fff; border-color: var(--ink); font-weight: 600; }
    .pcap .btn--primary:hover { background: var(--blue); border-color: var(--blue); box-shadow: none; }
    .pcap a:focus-visible, .pcap summary:focus-visible { outline: 2px solid var(--blue); outline-offset: 2px; }
    .pcap .hero__right { display: grid; gap: 1rem; }
    .pcap .photo { width: 220px; justify-self: end; border: 1px solid var(--line); padding: 6px; background: #fff; box-shadow: 0 10px 30px rgba(20,24,31,0.08); transform: rotate(1.5deg); }
    .pcap .photo img { display: block; width: 100%; height: auto; }
    .pcap .hex { margin: 0; font-family: var(--mono); font-size: 0.7rem; line-height: 1.6; color: var(--muted); background: #fff; border: 1px solid var(--line); padding: 0.9rem 1rem; overflow-x: auto; border-radius: 3px; }

    .pcap .pane { background: var(--panel); border: 1px solid var(--line); border-radius: 4px; overflow: hidden; animation: fade 500ms ease both; }
    .pcap .pane__hd { display: flex; justify-content: space-between; align-items: baseline; padding: 0.8rem 1rem; border-bottom: 1px solid var(--line); background: linear-gradient(#fff, #f2f4f8); }
    .pcap .pane__hd h2 { margin: 0; font-size: 0.95rem; font-weight: 800; letter-spacing: 0.02em; }
    .pcap .pane__count { font-family: var(--mono); font-size: 0.72rem; color: var(--muted); }

    .pcap .tbl { font-family: var(--mono); font-size: 0.8rem; }
    .pcap .tr { display: grid; grid-template-columns: 52px 72px 1.1fr 1fr 64px 1.6fr; gap: 0.75rem; align-items: center; padding: 0.5rem 1rem; }
    .pcap .tr--head { font-size: 0.7rem; color: var(--muted); border-bottom: 1px solid var(--line); background: #fafbfc; }
    .pcap .frame summary { list-style: none; cursor: pointer; border-bottom: 1px solid rgba(0,0,0,0.05); transition: filter 100ms; }
    .pcap .frame summary::-webkit-details-marker { display: none; }
    .pcap .frame summary:hover { filter: brightness(0.96); }
    .pcap .frame[open] summary { background-color: var(--blue) !important; color: #fff; }
    .pcap .frame[open] summary a { color: #fff; }
    .pcap .frame--tcp summary { background: var(--tcp); } .pcap .frame--tls summary { background: var(--tls); } .pcap .frame--http summary { background: var(--http); }
    .pcap .frame--dns summary { background: var(--dns); } .pcap .frame--arp summary { background: var(--arp); } .pcap .frame--icmp summary { background: var(--icmp); }
    .pcap .td { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .pcap .td--no { color: var(--muted); }
    .pcap .frame[open] .td--no { color: inherit; }
    .pcap .td--info { font-family: var(--sans); font-weight: 600; }
    .pcap .td--info a { color: var(--blue); text-decoration: none; } .pcap .td--info a:hover { text-decoration: underline; }
    .pcap .dissect { padding: 0.9rem 1rem 1.1rem 2.5rem; background: #fafbfd; border-bottom: 1px solid var(--line); font-size: 0.85rem; }
    .pcap .dissect__line { margin: 0 0 0.35rem; color: var(--muted); }
    .pcap .dissect__line--2 { padding-left: 1.2rem; }
    .pcap .dissect__val { color: var(--ink); font-family: var(--sans); }
    .pcap .dissect__list { margin: 0.4rem 0 0; padding-left: 2.6rem; display: grid; gap: 0.3rem; font-family: var(--sans); }
    .pcap .dissect__list li { position: relative; list-style: none; }
    .pcap .dissect__list li::before { content: "└ "; color: var(--muted); font-family: var(--mono); position: absolute; left: -1.4rem; }

    .pcap .badges { display: flex; flex-wrap: wrap; gap: 1rem; }
    .pcap .badge { display: flex; align-items: center; gap: 0.75rem; padding: 0.6rem 0.9rem 0.6rem 0.6rem; background: #fff; border: 1px solid var(--line); border-radius: 4px; color: var(--ink); text-decoration: none; font-size: 0.85rem; font-weight: 600; }
    .pcap .badge img { width: 64px; height: 64px; display: block; }
    .pcap .badge:hover { border-color: var(--blue); }

    .pcap .hier { padding: 1rem; display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 1.25rem 1.5rem; }
    .pcap .hier__group { position: relative; padding-bottom: 0.6rem; }
    .pcap .hier__hd { margin: 0 0 0.4rem; font-family: var(--mono); font-size: 0.78rem; font-weight: 600; color: var(--blue); }
    .pcap .hier__items { list-style: none; margin: 0; padding: 0 0 0 1.2rem; display: grid; gap: 0.2rem; font-size: 0.88rem; border-left: 1px dotted var(--line); }
    .pcap .hier__bar { position: absolute; left: 0; bottom: 0; height: 3px; width: var(--w); background: linear-gradient(90deg, var(--blue), #8cc6ff); border-radius: 2px; }

    .pcap .status { position: fixed; bottom: 0; left: 0; right: 0; z-index: 9; display: flex; justify-content: space-between; gap: 1rem; padding: 0.4rem 1.25rem 0.4rem 9rem; background: #fff; border-top: 1px solid var(--line); font-family: var(--mono); font-size: 0.7rem; color: var(--muted); }
    .pcap .status span:first-child { color: #2a8c3b; }

    @media (max-width: 900px) {
      .pcap .toolbar { grid-template-columns: 1fr; gap: 0.5rem; }
      .pcap .toolbar__right { display: none; }
      .pcap .hero { grid-template-columns: 1fr; }
      .pcap .photo { justify-self: start; }
      .pcap .tr { grid-template-columns: 40px 60px 1fr 1fr; }
      .pcap .td--len, .pcap .tr--head span:nth-child(5) { display: none; }
      .pcap .td--info, .pcap .tr--head span:nth-child(6) { grid-column: 1 / -1; white-space: normal; }
      .pcap .status { padding-left: 1.25rem; justify-content: flex-end; } .pcap .status span:not(:last-child) { display: none; }
    }
    @media (prefers-reduced-motion: reduce) { .pcap .hero, .pcap .pane { animation: none; } }
  </style>
</StyleShell>
