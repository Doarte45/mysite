---
import { Image } from "astro:assets";
import StyleShell from "../../layouts/StyleShell.astro";
import { cv } from "../../data/cv.ts";
import mePhoto from "../../assets/me.jpg";

const resume = `${import.meta.env.BASE_URL}/resume.pdf`.replace(/\/+/g, "/");
const user = (cv.name.split(" ")[0] ?? "user")
  .toLowerCase()
  .normalize("NFD")
  .replace(/[̀-ͯ]/g, "");
const host = "sec-ops";
const prompt = `${user}@${host}:~$`;
const motd = `Last login: from 10.0.0.2 on pts/1
` + String.raw`   ___  ___  ___   ___  ___  ___
  / __|| __|/ __| / _ \| _ \/ __|
  \__ \| _|| (__ | (_) |  _/\__ \
  |___/|___|\___| \___/|_|  |___/   // operator console v5.1`;
---

<StyleShell
  slug="terminal"
  styleName="Terminal"
  fonts="family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,700;1,400&family=VT323"
  bodyClass="tty"
>
  <div class="crt" aria-hidden="true"></div>

  <main id="main" class="screen">
    <header class="titlebar" aria-hidden="true">
      <span class="titlebar__btn"></span><span class="titlebar__btn"></span><span class="titlebar__btn"></span>
      <span class="titlebar__title">{user}@{host} — tmux — 132×48</span>
    </header>

    <section class="block block--banner">
      <pre class="motd" set:text={motd} />
    </section>

    <section class="block" style="--i:1">
      <p class="cmd"><span class="ps1">{prompt}</span> whoami --verbose</p>
      <div class="whoami">
        <div class="whoami__photo">
          <Image src={mePhoto} alt={`${cv.name} — portrait`} widths={[240, 480]} sizes="200px" width={480} loading="eager" />
          <span class="whoami__scan" aria-hidden="true"></span>
        </div>
        <div class="whoami__text">
          <h1 class="name">{cv.name}</h1>
          <p class="role"><span class="k">role</span>=<span class="v">"{cv.role}"</span></p>
          <p class="role"><span class="k">location</span>=<span class="v">"{cv.location}"</span></p>
          <p class="role"><span class="k">status</span>=<span class="v v--ok">● ONLINE</span></p>
          <p class="summary">{cv.summary}</p>
          <a class="btn" href={resume} target="_blank" rel="noopener">$ open resume.pdf <span class="caret" aria-hidden="true"></span></a>
        </div>
      </div>
    </section>

    <section class="block" style="--i:2">
      <p class="cmd"><span class="ps1">{prompt}</span> cat /etc/contact.conf</p>
      <dl class="kv">
        {cv.contact.map((c) => (<><dt>{c.label.toLowerCase()}</dt><dd><a href={c.href}>{c.value}</a></dd></>))}
      </dl>
    </section>

    <section class="block" style="--i:3">
      <p class="cmd"><span class="ps1">{prompt}</span> journalctl -u career --no-pager</p>
      <ol class="log">
        {cv.experience.map((e) => (
          <li class="entry">
            <div class="entry__head">
              <span class="ts">[{e.period}]</span>
              <h2 class="entry__title">{e.role}</h2>
              <span class="pid">{e.company} · {e.location}</span>
            </div>
            {e.summary && <p class="entry__sum">{e.summary}</p>}
            <ul class="hl">{e.highlights.map((h) => <li>{h}</li>)}</ul>
          </li>
        ))}
      </ol>
    </section>

    <section class="block" style="--i:4">
      <p class="cmd"><span class="ps1">{prompt}</span> ls -la ~/projects</p>
      <div class="ls">
        {cv.projects.map((p) => (
          <article class="ls__row">
            <span class="ls__mode">drwxr-x---</span>
            <span class="ls__date">{p.year}</span>
            <h2 class="ls__name">{p.url ? <a href={p.url.startsWith("http") ? p.url : `https://${p.url}`}>{p.name}/</a> : `${p.name}/`}</h2>
            {p.description && <p class="ls__desc">{p.description}</p>}
            <p class="ls__stack">{p.stack.map((s) => <code>{s}</code>)}</p>
            {p.highlights && <ul class="hl">{p.highlights.map((h) => <li>{h}</li>)}</ul>}
          </article>
        ))}
      </div>
    </section>

    <div class="split">
      <section class="block" style="--i:5">
        <p class="cmd"><span class="ps1">{prompt}</span> cat education.yaml</p>
        <div class="yaml">
          {cv.education.map((e) => (
            <div class="yaml__item">
              <span class="k">- degree:</span> <span class="v">{e.degree}</span><br />
              <span class="k">  institution:</span> <span class="v">{e.institution}</span><br />
              <span class="k">  period:</span> <span class="v">{e.period}</span>
              {e.detail && <><br /><span class="k">  note:</span> <span class="v v--dim">{e.detail}</span></>}
            </div>
          ))}
        </div>
      </section>
      <section class="block" style="--i:6">
        <p class="cmd"><span class="ps1">{prompt}</span> gpg --list-keys certifications</p>
        <div class="yaml">
          {cv.certifications.map((c) => (
            <div class="yaml__item cert">
              <span class="k">pub</span>  <span class="v">{c.name}</span><br />
              <span class="k">uid</span>  <span class="v v--dim">{c.issuer} · {c.date}</span>
              {c.detail && <><br /><span class="k">sig</span>  <span class="v v--dim">{c.detail}</span></>}
              {c.badgeImage && (
                <a class="badge" href={c.badgeId ? `https://www.credly.com/badges/${c.badgeId}` : undefined} target="_blank" rel="noopener noreferrer">
                  <img src={c.badgeImage} alt={`${c.name} badge`} width="110" height="110" loading="lazy" />
                </a>
              )}
            </div>
          ))}
        </div>
      </section>
    </div>

    <section class="block" style="--i:7">
      <p class="cmd"><span class="ps1">{prompt}</span> apt list --installed | grep skills</p>
      <div class="pkgs">
        {cv.skills.map((g) => (
          <div class="pkg">
            <h2 class="pkg__name">{g.heading.toLowerCase().replace(/[^a-z]+/g, "-")}/</h2>
            <ul>{g.items.map((s) => <li><span class="ok">[ok]</span> {s}</li>)}</ul>
          </div>
        ))}
      </div>
    </section>

    <p class="cmd cmd--live" style="--i:8"><span class="ps1">{prompt}</span> <span class="caret caret--blink" aria-hidden="true"></span></p>
  </main>

  <style is:global>
    body.tty {
      --bg: #050806;
      --ink: #b7f5c8;
      --ink-dim: #5e9a6f;
      --ink-bright: #e9ffef;
      --phosphor: #3dff8f;
      --amber: #ffb000;
      --rule: rgba(61, 255, 143, 0.18);
      --mono: "IBM Plex Mono", ui-monospace, monospace;
      --pixel: "VT323", var(--mono);
      background: radial-gradient(ellipse at 50% 0%, #0c1a10 0%, var(--bg) 60%);
      color: var(--ink);
      font-family: var(--mono);
      font-size: 0.95rem;
      line-height: 1.6;
      min-height: 100vh;
    }
    .tty .crt {
      position: fixed; inset: 0; pointer-events: none; z-index: 5;
      background:
        repeating-linear-gradient(0deg, rgba(0,0,0,0.22) 0 1px, transparent 1px 3px),
        radial-gradient(ellipse at center, transparent 55%, rgba(0,0,0,0.55) 100%);
      mix-blend-mode: multiply;
    }
    .tty .screen { max-width: 1100px; margin: 0 auto; padding: 2rem 1.5rem 7rem; position: relative; z-index: 1; }
    .tty .titlebar {
      display: flex; align-items: center; gap: 0.45rem; padding: 0.5rem 0.75rem; margin-bottom: 2rem;
      border: 1px solid var(--rule); border-radius: 6px 6px 0 0; color: var(--ink-dim); font-size: 0.75rem;
    }
    .tty .titlebar__btn { width: 10px; height: 10px; border-radius: 50%; border: 1px solid var(--ink-dim); }
    .tty .titlebar__title { margin-left: auto; margin-right: auto; }

    .tty .block { margin-bottom: 3.25rem; opacity: 0; transform: translateY(6px); animation: tty-in 400ms steps(4) forwards; animation-delay: calc(var(--i, 0) * 180ms); }
    @keyframes tty-in { to { opacity: 1; transform: none; } }
    .tty .motd { font-family: var(--pixel); font-size: 1.15rem; line-height: 1.1; color: var(--phosphor); text-shadow: 0 0 10px rgba(61,255,143,0.55); margin: 0; overflow-x: auto; }
    .tty .cmd { margin: 0 0 1.1rem; color: var(--ink-bright); font-weight: 500; }
    .tty .ps1 { color: var(--phosphor); font-weight: 700; text-shadow: 0 0 8px rgba(61,255,143,0.5); }
    .tty .caret { display: inline-block; width: 0.6em; height: 1.1em; background: var(--phosphor); vertical-align: -0.2em; margin-left: 0.2em; }
    .tty .caret--blink { animation: blink 1s steps(2) infinite; }
    @keyframes blink { 50% { opacity: 0; } }

    .tty .whoami { display: grid; grid-template-columns: 200px 1fr; gap: 2rem; align-items: start; }
    .tty .whoami__photo { position: relative; border: 1px solid var(--phosphor); padding: 4px; box-shadow: 0 0 24px rgba(61,255,143,0.2) inset; overflow: hidden; }
    .tty .whoami__photo img { display: block; width: 100%; height: auto; filter: grayscale(1) contrast(1.2) sepia(1) hue-rotate(80deg) saturate(2.2) brightness(0.9); }
    .tty .whoami__scan { position: absolute; left: 0; right: 0; height: 18%; top: -20%; background: linear-gradient(to bottom, transparent, rgba(61,255,143,0.35), transparent); animation: scan 3.2s linear infinite; }
    @keyframes scan { to { top: 120%; } }
    .tty .name { font-family: var(--pixel); font-size: clamp(2.4rem, 6vw, 4.2rem); line-height: 0.95; margin: 0 0 1rem; color: var(--ink-bright); text-shadow: 0 0 14px rgba(61,255,143,0.5), 2px 0 0 rgba(255,0,80,0.35), -2px 0 0 rgba(0,160,255,0.35); font-weight: 400; }
    .tty .role { margin: 0.1rem 0; }
    .tty .k { color: var(--amber); }
    .tty .v { color: var(--ink-bright); }
    .tty .v--ok { color: var(--phosphor); }
    .tty .v--dim { color: var(--ink-dim); }
    .tty .summary { margin: 1.25rem 0; max-width: 62ch; color: var(--ink); border-left: 2px solid var(--rule); padding-left: 1rem; }
    .tty .btn { display: inline-block; padding: 0.55rem 0.9rem; border: 1px solid var(--phosphor); color: var(--phosphor); text-decoration: none; transition: background 120ms, color 120ms; }
    .tty .btn:hover { background: var(--phosphor); color: var(--bg); }
    .tty .btn:hover .caret { background: var(--bg); }

    .tty .kv { display: grid; grid-template-columns: max-content 1fr; gap: 0.3rem 1.5rem; margin: 0; }
    .tty .kv dt { color: var(--amber); } .tty .kv dt::after { content: " ="; color: var(--ink-dim); }
    .tty .kv dd { margin: 0; overflow-wrap: anywhere; }
    .tty a { color: var(--ink-bright); text-decoration: underline; text-decoration-color: var(--rule); text-underline-offset: 3px; }
    .tty a:hover { color: var(--phosphor); text-decoration-color: var(--phosphor); }
    .tty a:focus-visible, .tty .btn:focus-visible { outline: 2px solid var(--amber); outline-offset: 2px; }

    .tty .log { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 2rem; }
    .tty .entry { border-left: 1px solid var(--rule); padding-left: 1.25rem; position: relative; }
    .tty .entry::before { content: "●"; position: absolute; left: -0.36em; top: 0.1em; color: var(--phosphor); font-size: 0.8rem; background: var(--bg); }
    .tty .entry__head { display: flex; flex-wrap: wrap; gap: 0.3rem 1rem; align-items: baseline; }
    .tty .ts { color: var(--ink-dim); }
    .tty .entry__title { font-size: 1.1rem; margin: 0; color: var(--ink-bright); font-weight: 700; }
    .tty .pid { color: var(--amber); font-size: 0.85rem; }
    .tty .entry__sum { margin: 0.5rem 0 0; max-width: 70ch; }
    .tty .hl { list-style: none; padding: 0; margin: 0.75rem 0 0; display: grid; gap: 0.35rem; }
    .tty .hl li { padding-left: 1.4rem; position: relative; color: var(--ink); font-size: 0.9rem; }
    .tty .hl li::before { content: "└─"; position: absolute; left: 0; color: var(--ink-dim); }

    .tty .ls { display: grid; gap: 1.75rem; }
    .tty .ls__row { display: grid; grid-template-columns: max-content max-content 1fr; gap: 0.25rem 1.25rem; align-items: baseline; }
    .tty .ls__mode { color: var(--ink-dim); font-size: 0.8rem; } .tty .ls__date { color: var(--amber); font-size: 0.85rem; }
    .tty .ls__name { font-size: 1.1rem; margin: 0; color: var(--phosphor); font-weight: 700; }
    .tty .ls__name a { color: inherit; }
    .tty .ls__desc, .tty .ls__stack, .tty .ls__row .hl { grid-column: 3; margin: 0; }
    .tty .ls__stack { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.4rem; }
    .tty .ls__stack code { font-size: 0.75rem; padding: 0.1rem 0.45rem; border: 1px solid var(--rule); color: var(--ink-dim); }

    .tty .split { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; }
    .tty .yaml { display: grid; gap: 1.25rem; }
    .tty .yaml__item { white-space: pre-wrap; }
    .tty .badge { display: block; margin-top: 0.75rem; width: max-content; }
    .tty .badge img { display: block; filter: grayscale(1) sepia(1) hue-rotate(80deg) saturate(2); opacity: 0.85; transition: filter 150ms, opacity 150ms; }
    .tty .badge:hover img { filter: none; opacity: 1; }

    .tty .pkgs { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 1.5rem 2rem; }
    .tty .pkg__name { font-size: 0.9rem; color: var(--amber); margin: 0 0 0.4rem; font-weight: 700; }
    .tty .pkg ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.2rem; font-size: 0.9rem; }
    .tty .ok { color: var(--phosphor); }
    .tty .cmd--live { opacity: 0; animation: tty-in 300ms steps(2) forwards; animation-delay: calc(var(--i) * 180ms); }

    @media (max-width: 760px) {
      .tty .whoami, .tty .split { grid-template-columns: 1fr; }
      .tty .whoami__photo { max-width: 200px; }
      .tty .ls__row { grid-template-columns: 1fr; }
      .tty .ls__desc, .tty .ls__stack, .tty .ls__row .hl { grid-column: 1; }
      .tty .motd { font-size: 0.85rem; }
    }
    @media (prefers-reduced-motion: reduce) {
      .tty .block, .tty .cmd--live { animation: none; opacity: 1; transform: none; }
      .tty .whoami__scan, .tty .caret--blink { animation: none; }
    }
  </style>
</StyleShell>
