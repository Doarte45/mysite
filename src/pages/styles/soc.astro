---
import { Image } from "astro:assets";
import StyleShell from "../../layouts/StyleShell.astro";
import { cv } from "../../data/cv.ts";
import mePhoto from "../../assets/me.jpg";

const resume = `${import.meta.env.BASE_URL}/resume.pdf`.replace(/\/+/g, "/");
const skillCount = cv.skills.reduce((n, g) => n + g.items.length, 0);
const stats = [
  { label: "Roles", value: cv.experience.length, unit: "active" },
  { label: "Projects", value: cv.projects.length, unit: "shipped" },
  { label: "Certs", value: cv.certifications.length, unit: "verified" },
  { label: "Skills", value: skillCount, unit: "indexed" },
];
const sev = ["crit", "high", "med", "low", "info"] as const;
---

<StyleShell
  slug="soc"
  styleName="SOC Console"
  fonts="family=Chakra+Petch:wght@400;600;700&family=JetBrains+Mono:wght@400;500;700"
  bodyClass="soc"
>
  <div class="grid-bg" aria-hidden="true"></div>

  <header class="topbar">
    <div class="topbar__brand">
      <span class="pulse" aria-hidden="true"></span>
      <span class="topbar__title">SOC // {cv.name.toUpperCase()}</span>
    </div>
    <div class="topbar__meta">
      <span>ENV: PROD</span>
      <span>REGION: {cv.location.toUpperCase()}</span>
      <span class="topbar__ok">ALL SYSTEMS NOMINAL</span>
    </div>
  </header>

  <main id="main" class="board">
    <!-- hero tile -->
    <section class="tile tile--hero" style="--i:0">
      <div class="tile__hd"><span>IDENTITY</span><span class="chip chip--ok">authenticated</span></div>
      <div class="hero">
        <div class="hero__avatar">
          <Image src={mePhoto} alt={`${cv.name} — portrait`} widths={[240, 480]} sizes="180px" width={480} loading="eager" />
          <svg class="hero__ring" viewBox="0 0 100 100" aria-hidden="true">
            <circle cx="50" cy="50" r="47" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="4 6" />
            <circle class="hero__ring-arc" cx="50" cy="50" r="47" fill="none" stroke="currentColor" stroke-width="2" stroke-dasharray="70 300" stroke-linecap="round" />
          </svg>
        </div>
        <div>
          <p class="eyebrow">OPERATOR</p>
          <h1 class="hero__name">{cv.name}</h1>
          <p class="hero__role">{cv.role}</p>
          <p class="hero__sum">{cv.summary}</p>
          <div class="hero__actions">
            <a class="btn btn--primary" href={resume} target="_blank" rel="noopener">EXPORT REPORT (PDF)</a>
            {cv.contact.map((c) => <a class="btn" href={c.href}>{c.label.toUpperCase()}</a>)}
          </div>
        </div>
      </div>
    </section>

    <!-- stats -->
    {stats.map((s, idx) => (
      <section class="tile tile--stat" style={`--i:${idx + 1}`}>
        <p class="stat__label">{s.label}</p>
        <p class="stat__value">{String(s.value).padStart(2, "0")}</p>
        <p class="stat__unit">{s.unit}</p>
        <span class="stat__spark" aria-hidden="true"></span>
      </section>
    ))}

    <!-- experience -->
    <section class="tile tile--wide" style="--i:5">
      <div class="tile__hd"><span>EVENT TIMELINE · EXPERIENCE</span><span class="chip">{cv.experience.length} events</span></div>
      <ol class="timeline">
        {cv.experience.map((e, idx) => (
          <li class="ev">
            <span class={`sev sev--${sev[idx % sev.length]}`} aria-hidden="true"></span>
            <div class="ev__time">{e.period}</div>
            <div class="ev__body">
              <h2 class="ev__title">{e.role}</h2>
              <p class="ev__src">{e.company} <span class="dim">/</span> {e.location}</p>
              {e.summary && <p class="ev__sum">{e.summary}</p>}
              <ul class="ev__hl">{e.highlights.map((h) => <li>{h}</li>)}</ul>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <!-- projects -->
    <section class="tile tile--wide" style="--i:6">
      <div class="tile__hd"><span>DETECTIONS · PROJECTS</span><span class="chip chip--warn">{cv.projects.length} open</span></div>
      <div class="cases">
        {cv.projects.map((p, idx) => (
          <article class="case">
            <header class="case__hd">
              <span class="case__id">CASE-{String(idx + 1).padStart(3, "0")}</span>
              <span class="case__year">{p.year}</span>
            </header>
            <h2 class="case__title">{p.url ? <a href={p.url.startsWith("http") ? p.url : `https://${p.url}`}>{p.name} ↗</a> : p.name}</h2>
            {p.description && <p class="case__desc">{p.description}</p>}
            {p.highlights && <ul class="ev__hl">{p.highlights.map((h) => <li>{h}</li>)}</ul>}
            <footer class="case__tags">{p.stack.map((s) => <span class="tag">{s}</span>)}</footer>
          </article>
        ))}
      </div>
    </section>

    <!-- education -->
    <section class="tile tile--half" style="--i:7">
      <div class="tile__hd"><span>ASSET INVENTORY · EDUCATION</span></div>
      <ul class="list">
        {cv.education.map((e) => (
          <li class="list__item">
            <div class="list__meta">{e.period}</div>
            <div>
              <h2 class="list__title">{e.degree}</h2>
              <p class="list__sub">{e.institution}</p>
              {e.detail && <p class="list__detail">{e.detail}</p>}
            </div>
          </li>
        ))}
      </ul>
    </section>

    <!-- certs -->
    <section class="tile tile--half" style="--i:8">
      <div class="tile__hd"><span>COMPLIANCE · CERTIFICATIONS</span><span class="chip chip--ok">passing</span></div>
      <ul class="list">
        {cv.certifications.map((c) => (
          <li class="list__item">
            <div class="list__meta">{c.date}</div>
            <div class="list__cert">
              <div>
                <h2 class="list__title">{c.name}</h2>
                <p class="list__sub">{c.issuer}</p>
                {c.detail && <p class="list__detail">{c.detail}</p>}
              </div>
              {c.badgeImage && (
                <a class="badge" href={c.badgeId ? `https://www.credly.com/badges/${c.badgeId}` : undefined} target="_blank" rel="noopener noreferrer">
                  <img src={c.badgeImage} alt={`${c.name} badge`} width="88" height="88" loading="lazy" />
                </a>
              )}
            </div>
          </li>
        ))}
      </ul>
    </section>

    <!-- skills -->
    <section class="tile tile--wide" style="--i:9">
      <div class="tile__hd"><span>CAPABILITY MATRIX · SKILLS</span><span class="chip">{skillCount} entries</span></div>
      <div class="matrix">
        {cv.skills.map((g) => (
          <div class="matrix__group">
            <h2 class="matrix__hd">{g.heading}</h2>
            <ul class="matrix__items">{g.items.map((s) => <li>{s}</li>)}</ul>
          </div>
        ))}
      </div>
    </section>
  </main>

  <style is:global>
    body.soc {
      --bg: #070b12;
      --panel: #0d1420;
      --panel-2: #111a29;
      --line: #1d2a3f;
      --text: #d7e1f0;
      --muted: #7a8ba6;
      --cyan: #19d3ff;
      --green: #2ee59d;
      --amber: #ffb627;
      --red: #ff4d6d;
      --sans: "Chakra Petch", system-ui, sans-serif;
      --mono: "JetBrains Mono", ui-monospace, monospace;
      background: var(--bg);
      color: var(--text);
      font-family: var(--sans);
      line-height: 1.55;
      min-height: 100vh;
    }
    .soc .grid-bg {
      position: fixed; inset: 0; z-index: 0; pointer-events: none;
      background-image:
        linear-gradient(rgba(25,211,255,0.05) 1px, transparent 1px),
        linear-gradient(90deg, rgba(25,211,255,0.05) 1px, transparent 1px);
      background-size: 40px 40px;
      mask-image: radial-gradient(ellipse at top, #000 30%, transparent 80%);
    }
    .soc .topbar {
      position: sticky; top: 0; z-index: 10;
      display: flex; justify-content: space-between; align-items: center; gap: 1rem;
      padding: 0.7rem 1.5rem; font-family: var(--mono); font-size: 0.72rem; letter-spacing: 0.08em;
      background: rgba(7,11,18,0.85); border-bottom: 1px solid var(--line); backdrop-filter: blur(10px);
    }
    .soc .topbar__brand { display: flex; align-items: center; gap: 0.6rem; font-weight: 700; color: var(--cyan); }
    .soc .topbar__meta { display: flex; gap: 1.5rem; color: var(--muted); }
    .soc .topbar__ok { color: var(--green); }
    .soc .pulse { width: 8px; height: 8px; border-radius: 50%; background: var(--green); box-shadow: 0 0 0 0 rgba(46,229,157,0.6); animation: soc-pulse 1.8s ease-out infinite; }
    @keyframes soc-pulse { 70% { box-shadow: 0 0 0 10px rgba(46,229,157,0); } 100% { box-shadow: 0 0 0 0 rgba(46,229,157,0); } }

    .soc .board {
      position: relative; z-index: 1; max-width: 1320px; margin: 0 auto; padding: 1.5rem 1.5rem 7rem;
      display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem;
    }
    .soc .tile {
      background: linear-gradient(180deg, var(--panel-2), var(--panel)); border: 1px solid var(--line); border-radius: 4px;
      padding: 1.25rem 1.4rem; position: relative; overflow: hidden;
      opacity: 0; transform: translateY(10px); animation: soc-in 500ms cubic-bezier(.2,.8,.2,1) forwards; animation-delay: calc(var(--i) * 70ms);
    }
    @keyframes soc-in { to { opacity: 1; transform: none; } }
    .soc .tile::before { content: ""; position: absolute; inset: 0 auto auto 0; width: 100%; height: 2px; background: linear-gradient(90deg, var(--cyan), transparent 60%); opacity: 0.7; }
    .soc .tile--hero { grid-column: span 4; }
    .soc .tile--wide { grid-column: span 4; }
    .soc .tile--half { grid-column: span 2; }
    .soc .tile__hd {
      display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: 1.1rem;
      font-family: var(--mono); font-size: 0.7rem; letter-spacing: 0.14em; color: var(--muted);
    }
    .soc .chip { padding: 0.15rem 0.55rem; border: 1px solid var(--line); border-radius: 999px; font-size: 0.65rem; letter-spacing: 0.08em; text-transform: uppercase; }
    .soc .chip--ok { color: var(--green); border-color: rgba(46,229,157,0.4); }
    .soc .chip--warn { color: var(--amber); border-color: rgba(255,182,39,0.4); }

    .soc .hero { display: grid; grid-template-columns: 180px 1fr; gap: 2rem; align-items: center; }
    .soc .hero__avatar { position: relative; width: 180px; height: 180px; color: var(--cyan); }
    .soc .hero__avatar img { width: 100%; height: 100%; object-fit: cover; border-radius: 50%; display: block; filter: saturate(0.8) contrast(1.05); }
    .soc .hero__ring { position: absolute; inset: -10px; width: calc(100% + 20px); height: calc(100% + 20px); }
    .soc .hero__ring-arc { transform-origin: 50% 50%; animation: spin 9s linear infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }
    .soc .eyebrow { font-family: var(--mono); font-size: 0.7rem; letter-spacing: 0.3em; color: var(--cyan); margin: 0 0 0.4rem; }
    .soc .hero__name { font-size: clamp(2rem, 4.5vw, 3.4rem); font-weight: 700; margin: 0; line-height: 1; letter-spacing: -0.01em; text-transform: uppercase; }
    .soc .hero__role { margin: 0.5rem 0 1rem; color: var(--muted); font-family: var(--mono); font-size: 0.85rem; }
    .soc .hero__sum { margin: 0 0 1.25rem; max-width: 70ch; color: var(--text); font-size: 1rem; }
    .soc .hero__actions { display: flex; flex-wrap: wrap; gap: 0.6rem; }
    .soc .btn { font-family: var(--mono); font-size: 0.72rem; letter-spacing: 0.1em; padding: 0.55rem 0.9rem; border: 1px solid var(--line); border-radius: 3px; color: var(--text); text-decoration: none; transition: border-color 120ms, background 120ms, color 120ms; }
    .soc .btn:hover { border-color: var(--cyan); color: var(--cyan); }
    .soc .btn--primary { background: var(--cyan); color: #04151c; border-color: var(--cyan); font-weight: 700; }
    .soc .btn--primary:hover { background: #5be0ff; color: #04151c; }
    .soc a:focus-visible { outline: 2px solid var(--amber); outline-offset: 2px; }

    .soc .tile--stat { padding: 1rem 1.2rem 1.1rem; }
    .soc .stat__label { margin: 0; font-family: var(--mono); font-size: 0.68rem; letter-spacing: 0.2em; color: var(--muted); }
    .soc .stat__value { margin: 0.2rem 0 0; font-family: var(--mono); font-size: 2.6rem; font-weight: 700; line-height: 1; color: var(--cyan); }
    .soc .stat__unit { margin: 0.2rem 0 0; font-size: 0.75rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.1em; }
    .soc .stat__spark { position: absolute; right: 1rem; bottom: 1rem; width: 70px; height: 24px; background: repeating-linear-gradient(90deg, var(--green) 0 3px, transparent 3px 7px); mask-image: linear-gradient(to top, #000 20%, transparent 100%); opacity: 0.6; }

    .soc .timeline { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.25rem; }
    .soc .ev { display: grid; grid-template-columns: 6px 140px 1fr; gap: 1.25rem; padding: 1rem 0; border-top: 1px solid var(--line); }
    .soc .ev:first-child { border-top: 0; padding-top: 0; }
    .soc .sev { border-radius: 2px; align-self: stretch; }
    .soc .sev--crit { background: var(--red); } .soc .sev--high { background: var(--amber); } .soc .sev--med { background: var(--cyan); } .soc .sev--low { background: var(--green); } .soc .sev--info { background: var(--muted); }
    .soc .ev__time { font-family: var(--mono); font-size: 0.78rem; color: var(--muted); padding-top: 0.2rem; }
    .soc .ev__title { margin: 0; font-size: 1.15rem; font-weight: 700; }
    .soc .ev__src { margin: 0.15rem 0 0.6rem; font-family: var(--mono); font-size: 0.78rem; color: var(--cyan); }
    .soc .dim { color: var(--muted); }
    .soc .ev__sum { margin: 0 0 0.6rem; color: var(--text); font-size: 0.95rem; max-width: 80ch; }
    .soc .ev__hl { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.35rem; font-size: 0.9rem; color: #b8c5d9; }
    .soc .ev__hl li { padding-left: 1.1rem; position: relative; }
    .soc .ev__hl li::before { content: ""; position: absolute; left: 0; top: 0.6em; width: 6px; height: 2px; background: var(--cyan); }

    .soc .cases { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1rem; }
    .soc .case { background: var(--bg); border: 1px solid var(--line); padding: 1rem 1.1rem; border-radius: 3px; display: flex; flex-direction: column; gap: 0.6rem; transition: border-color 150ms, transform 150ms; }
    .soc .case:hover { border-color: var(--cyan); transform: translateY(-2px); }
    .soc .case__hd { display: flex; justify-content: space-between; font-family: var(--mono); font-size: 0.7rem; color: var(--muted); letter-spacing: 0.1em; }
    .soc .case__id { color: var(--amber); }
    .soc .case__title { margin: 0; font-size: 1.1rem; font-weight: 700; }
    .soc .case__title a { color: inherit; text-decoration: none; } .soc .case__title a:hover { color: var(--cyan); }
    .soc .case__desc { margin: 0; font-size: 0.92rem; color: #b8c5d9; }
    .soc .case__tags { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-top: auto; padding-top: 0.4rem; }
    .soc .tag { font-family: var(--mono); font-size: 0.65rem; padding: 0.15rem 0.45rem; background: var(--panel-2); border: 1px solid var(--line); color: var(--muted); border-radius: 2px; }

    .soc .list { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; }
    .soc .list__item { display: grid; grid-template-columns: 110px 1fr; gap: 1rem; padding-top: 1rem; border-top: 1px solid var(--line); }
    .soc .list__item:first-child { border-top: 0; padding-top: 0; }
    .soc .list__meta { font-family: var(--mono); font-size: 0.75rem; color: var(--muted); }
    .soc .list__title { margin: 0; font-size: 1rem; font-weight: 700; }
    .soc .list__sub { margin: 0.1rem 0 0; color: var(--cyan); font-family: var(--mono); font-size: 0.75rem; }
    .soc .list__detail { margin: 0.4rem 0 0; font-size: 0.88rem; color: #b8c5d9; }
    .soc .list__cert { display: flex; justify-content: space-between; gap: 1rem; align-items: flex-start; }
    .soc .badge img { display: block; width: 88px; height: auto; }

    .soc .matrix { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 1.25rem; }
    .soc .matrix__group { border-left: 2px solid var(--line); padding-left: 0.9rem; }
    .soc .matrix__hd { margin: 0 0 0.5rem; font-family: var(--mono); font-size: 0.7rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--cyan); }
    .soc .matrix__items { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.35rem; }
    .soc .matrix__items li { font-size: 0.8rem; padding: 0.25rem 0.55rem; background: var(--bg); border: 1px solid var(--line); border-radius: 2px; }

    @media (max-width: 960px) {
      .soc .board { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .soc .tile--hero, .soc .tile--wide, .soc .tile--half { grid-column: span 2; }
      .soc .topbar__meta span:not(.topbar__ok) { display: none; }
    }
    @media (max-width: 640px) {
      .soc .hero { grid-template-columns: 1fr; }
      .soc .ev { grid-template-columns: 6px 1fr; } .soc .ev__body { grid-column: 2; }
      .soc .list__item { grid-template-columns: 1fr; gap: 0.3rem; }
    }
    @media (prefers-reduced-motion: reduce) {
      .soc .tile { animation: none; opacity: 1; transform: none; }
      .soc .hero__ring-arc, .soc .pulse { animation: none; }
    }
  </style>
</StyleShell>
