---
import { Image } from "astro:assets";
import BaseHead from "../layouts/BaseHead.astro";
import { cv } from "../data/cv.ts";
import mePhoto from "../assets/me.jpg";

const nameParts = cv.name.split(" ");
const firstName = nameParts[0];
const lastName = nameParts.slice(1).join(" ");

const base = import.meta.env.BASE_URL;
const resumeHref = `${base}/resume.pdf`.replace(/\/+/g, "/");

const siteUrl = new URL(base, Astro.site ?? Astro.url.origin).toString();
const emailLink = cv.contact.find((c) => c.href.startsWith("mailto:"));
const email = emailLink?.value;
const linkedin = cv.contact.find((c) => /linkedin/i.test(c.label));
const location = cv.contact.find((c) => /location/i.test(c.label));
const languages = cv.skills.find((g) => /language/i.test(g.heading));
const techSkills = cv.skills.filter((g) => g !== languages);
// "University of Texas at San Antonio (UTSA)" -> "UTSA"; falls back to the full name.
const schoolShort = [...new Set(cv.education.map((e) => e.institution.match(/\(([^)]+)\)\s*$/)?.[1] ?? e.institution))];

const personLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: cv.name,
  jobTitle: cv.role,
  url: siteUrl,
  ...(email && { email: `mailto:${email}` }),
  sameAs: cv.contact
    .filter((c) => c.href.startsWith("http") && c.label !== "Location")
    .map((c) => c.href),
  alumniOf: cv.education.map((e) => ({
    "@type": "EducationalOrganization",
    name: e.institution,
  })),
};

const sections = [
  { id: "experience", label: "Experience", alias: "hop_history" },
  { id: "projects", label: "Projects", alias: "mission_log" },
  { id: "education", label: "Education", alias: "training_data" },
  { id: "skills", label: "Skills", alias: "security_stack" },
  { id: "contact", label: "Contact", alias: "uplink" },
];
const sec = Object.fromEntries(sections.map((s, i) => [s.id, { ...s, n: String(i + 1).padStart(2, "0") }]));

// Split the summary into sentences so the hero can lift the "Seeking …" line
// and the About block doesn't repeat what the hero already says.
const sentences = cv.summary.match(/[^.!?]+(?:[.!?](?=\s|$))+/g)?.map((t) => t.trim()) ?? [cv.summary];
const seekingSentence = sentences.find((t) => /^seeking\b/i.test(t));
const targetRoles = seekingSentence
  ?.replace(/^seeking\s+/i, "").replace(/\s+roles?\.?$/i, "")
  .split(/,\s*(?:or\s+|and\s+)?|\s+or\s+/).map((r) => r.trim()).filter(Boolean) ?? [];
const aboutSentences = sentences.filter(
  (t, i) => t !== seekingSentence && !(i === 0 && /available/i.test(t)),
);

const escapeHtml = (t: string) =>
  t.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
// Emphasise quantified results (percentages, costs, counts) so they pop when skimming.
const METRIC = /(~?\d[\d.]*%|\$\d[\d.]*(?:\/session)?|\d+\+?\s(?:hours|hands-on labs)|\d+-session|\bzero sessions\b|\bsix simultaneously active faults\b)/gi;
const emph = (t: string) => escapeHtml(t).replace(METRIC, '<strong class="metric">$1</strong>');
const BULLET_CAP = 4;

const projectHref = (url: string) => (url.startsWith("http") ? url : `https://${url}`);
const prettyUrl = (url: string) => url.replace(/^https?:\/\//, "").replace(/\/$/, "");
---

<html lang="en">
  <head>
    <BaseHead
      title={`${cv.name} — Cybersecurity Engineer`}
      description={`${cv.name}, ${cv.role}. ${cv.tagline}`}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("v3-theme");
          var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          document.documentElement.dataset.v3Theme = stored || (prefersDark ? "dark" : "light");
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="v3">
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="topbar">
      <div class="topbar__inner">
        <a class="brand" href="#top" aria-label="Back to top">
          <span class="brand__prompt">~/</span>{firstName.toLowerCase()}<span class="brand__cursor" aria-hidden="true"></span>
        </a>
        <nav class="topnav" aria-label="Sections">
          {sections.map((s) => <a href={`#${s.id}`} data-nav={s.id}>{s.label}</a>)}
        </nav>
        <button class="theme-toggle" type="button" aria-label="Toggle dark mode" aria-pressed="false" data-theme-toggle>
          <svg class="icon icon--sun" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="4" fill="currentColor" />
            <g stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
              <line x1="12" y1="2" x2="12" y2="5" /><line x1="12" y1="19" x2="12" y2="22" />
              <line x1="2" y1="12" x2="5" y2="12" /><line x1="19" y1="12" x2="22" y2="12" />
              <line x1="4.5" y1="4.5" x2="6.5" y2="6.5" /><line x1="17.5" y1="17.5" x2="19.5" y2="19.5" />
              <line x1="4.5" y1="19.5" x2="6.5" y2="17.5" /><line x1="17.5" y1="6.5" x2="19.5" y2="4.5" />
            </g>
          </svg>
          <svg class="icon icon--moon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20 14.5A8 8 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5z" fill="currentColor" />
          </svg>
        </button>
      </div>
    </header>

    <main id="main">
      <!-- HERO -->
      <section class="hero" id="top" aria-label="Introduction">
        <div class="hero__grid-bg" aria-hidden="true"></div>
        <div class="hero__text">
          <p class="status"><span class="status__dot" aria-hidden="true"></span>Available for full-time roles</p>
          <h1>{firstName} <span class="h1__last">{lastName}</span></h1>
          <p class="hero__tagline">{cv.tagline}.</p>
          {targetRoles.length > 0 && (
            <div class="targets">
              <span class="targets__label">Open to</span>
              <ul>{targetRoles.map((r) => <li>{r}</li>)}</ul>
            </div>
          )}

          <div class="cta-row">
            <a class="btn btn--primary" href={resumeHref} target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m0 0-5-5m5 5 5-5M5 21h14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              Download CV <span class="btn__meta">PDF</span>
            </a>
            {emailLink && (
              <a class="btn" href={emailLink.href}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="2"/><path d="m3 7 9 6 9-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
                Email me
              </a>
            )}
            {linkedin && (
              <a class="btn" href={linkedin.href} target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9.75h4V21H3zM9.5 9.75h3.8v1.6h.06c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.77 2.65 4.77 6.1V21h-4v-4.98c0-1.19-.02-2.72-1.66-2.72-1.66 0-1.92 1.3-1.92 2.63V21h-4z"/></svg>
                LinkedIn
              </a>
            )}
          </div>
        </div>

        <figure class="portrait">
          <svg class="topo" viewBox="0 0 400 520" aria-hidden="true">
            <g class="topo__links">
              <path id="l1" d="M24 118 L24 34 L376 34" />
              <path id="l3" d="M376 34 L380 290" /><path id="l4" d="M380 290 L322 496" />
              <path id="l5" d="M24 118 L22 396" /><path id="l6" d="M22 396 L22 496 L322 496" />
            </g>
            <g class="topo__packets">
              <circle r="3"><animateMotion dur="6s" repeatCount="indefinite"><mpath href="#l1" /></animateMotion></circle>
              <circle r="3"><animateMotion dur="6s" repeatCount="indefinite"><mpath href="#l5" /></animateMotion></circle>
              <circle r="3"><animateMotion dur="5s" repeatCount="indefinite"><mpath href="#l3" /></animateMotion></circle>
            </g>
            <g class="topo__nodes">
              <g transform="translate(24 118)"><rect x="-16" y="-10" width="32" height="20" rx="4" /><text y="3.5">R1</text></g>
              <g transform="translate(376 34)"><rect x="-16" y="-10" width="32" height="20" rx="4" /><text y="3.5">R2</text></g>
              <g transform="translate(380 290)"><rect x="-16" y="-10" width="32" height="20" rx="4" /><text y="3.5">R3</text></g>
              <g transform="translate(22 396)"><rect x="-18" y="-10" width="36" height="20" rx="4" /><text y="3.5">DMZ</text></g>
              <g transform="translate(322 496)"><rect x="-18" y="-10" width="36" height="20" rx="4" /><text y="3.5">SOC</text></g>
            </g>
          </svg>
          <div class="portrait__frame">
            <span class="corner corner--tl" aria-hidden="true"></span>
            <span class="corner corner--tr" aria-hidden="true"></span>
            <span class="corner corner--bl" aria-hidden="true"></span>
            <span class="corner corner--br" aria-hidden="true"></span>
            <Image
              src={mePhoto}
              alt={`Portrait of ${cv.name}`}
              widths={[240, 360, 480, 720]}
              sizes="(max-width: 760px) 120px, 320px"
              width={720}
              loading="eager"
              fetchpriority="high"
            />
          </div>
          <figcaption class="portrait__caption" aria-hidden="true">
            <span>node 10.0.0.1</span><span class="portrait__ok">● online</span>
          </figcaption>
        </figure>

        <dl class="facts">
          {location && (
            <div class="fact">
              <dt>Based in</dt>
              <dd>{location.value}</dd>
            </div>
          )}
          <div class="fact">
            <dt>Education</dt>
            <dd>{schoolShort.join(" · ")}</dd>
          </div>
          <div class="fact">
            <dt>Certified</dt>
            <dd>{cv.certifications.map((c) => c.name.replace(/\s*Certification$/i, "")).join(" · ")}</dd>
          </div>
          {languages && (
            <div class="fact">
              <dt>Languages</dt>
              <dd>{languages.items.join(" · ")}</dd>
            </div>
          )}
        </dl>
      </section>

      <!-- ABOUT -->
      <section class="about" aria-label="About">
        <p class="about__label">// about</p>
        <p class="about__text">{aboutSentences.join(" ")}</p>
      </section>

      <!-- EXPERIENCE -->
      <section class="section" id="experience" aria-labelledby="experience-h">
        <div class="section__head">
          <span class="section__num">{sec.experience.n}</span>
          <h2 id="experience-h">{sec.experience.label}</h2>
          <span class="section__alias" aria-hidden="true">{sec.experience.alias}</span>
        </div>
        <ol class="timeline">
          {cv.experience.map((exp) => (
            <li class="tl-item">
              <div class="tl-item__meta">
                <span class="tl-item__period">{exp.period}</span>
              </div>
              <div class="tl-item__body">
                <h3>{exp.role}</h3>
                <p class="org"><strong>{exp.company}</strong> <span class="org__sep">·</span> {exp.location}</p>
                {exp.summary && <p class="desc">{exp.summary}</p>}
                <ul class="bullets">
                  {exp.highlights.slice(0, BULLET_CAP).map((h) => <li set:html={emph(h)} />)}
                </ul>
                {exp.highlights.length > BULLET_CAP && (
                  <details class="more">
                    <summary>
                      <span class="more__open">Show {exp.highlights.length - BULLET_CAP} more</span>
                      <span class="more__close">Show less</span>
                    </summary>
                    <ul class="bullets">
                      {exp.highlights.slice(BULLET_CAP).map((h) => <li set:html={emph(h)} />)}
                    </ul>
                  </details>
                )}
              </div>
            </li>
          ))}
        </ol>
      </section>

      <!-- PROJECTS -->
      <section class="section" id="projects" aria-labelledby="projects-h">
        <div class="section__head">
          <span class="section__num">{sec.projects.n}</span>
          <h2 id="projects-h">{sec.projects.label}</h2>
          <span class="section__alias" aria-hidden="true">{sec.projects.alias}</span>
        </div>
        <div class="projects">
          {cv.projects.map((p, i) => (
            <article class:list={["card", "project", { "project--featured": i === 0 }]}>
              {i === 0 && <span class="project__flag">Featured research</span>}
              <span class="card__date">{p.year}</span>
              <h3>{p.name}</h3>
              {p.description && <p class="desc">{p.description}</p>}
              {p.highlights && (
                <ul class="bullets">
                  {p.highlights.map((h) => <li set:html={emph(h)} />)}
                </ul>
              )}
              <div class="project__foot">
                <ul class="chips" aria-label="Tools used">
                  {p.stack.map((s) => <li class="chip">{s}</li>)}
                </ul>
                {p.url && (
                  <a class="text-link" href={projectHref(p.url)} target="_blank" rel="noopener">
                    {prettyUrl(p.url)} <span aria-hidden="true">↗</span>
                  </a>
                )}
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- EDUCATION + CERTS -->
      <section class="section" id="education" aria-labelledby="education-h">
        <div class="section__head">
          <span class="section__num">{sec.education.n}</span>
          <h2 id="education-h">Education &amp; certifications</h2>
          <span class="section__alias" aria-hidden="true">{sec.education.alias}</span>
        </div>
        <div class="edu-split">
          <div>
            <h3 class="sub-h">Degrees</h3>
            <ol class="timeline timeline--compact">
              {cv.education.map((e) => (
                <li class="tl-item">
                  <div class="tl-item__meta"><span class="tl-item__period">{e.period}</span></div>
                  <div class="tl-item__body">
                    <h3>{e.degree}</h3>
                    <p class="org"><strong>{e.institution}</strong></p>
                    {e.detail && <p class="desc">{e.detail}</p>}
                  </div>
                </li>
              ))}
            </ol>
          </div>
          <div>
            <h3 class="sub-h" id="certifications">Certifications</h3>
            <div class="certs">
              {cv.certifications.map((c) => (
                <article class="card cert">
                  <div class="cert__head">
                    <div>
                      <span class="card__date">{c.date}</span>
                      <h3>{c.name}</h3>
                      <p class="org"><strong>{c.issuer}</strong></p>
                    </div>
                    {c.badgeImage && (
                      c.badgeId ? (
                        <a class="cert__badge" href={`https://www.credly.com/badges/${c.badgeId}`} target="_blank" rel="noopener noreferrer" title="Verify on Credly">
                          <img src={c.badgeImage} alt={`${c.name} badge — verify on Credly`} width="72" height="72" loading="lazy" />
                        </a>
                      ) : (
                        <span class="cert__badge"><img src={c.badgeImage} alt={`${c.name} badge`} width="72" height="72" loading="lazy" /></span>
                      )
                    )}
                  </div>
                  {c.detail && <p class="desc desc--sm" set:html={emph(c.detail)} />}
                  {c.badgeId && (
                    <a class="text-link" href={`https://www.credly.com/badges/${c.badgeId}`} target="_blank" rel="noopener noreferrer">
                      Verify credential <span aria-hidden="true">↗</span>
                    </a>
                  )}
                </article>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- SKILLS -->
      <section class="section" id="skills" aria-labelledby="skills-h">
        <div class="section__head">
          <span class="section__num">{sec.skills.n}</span>
          <h2 id="skills-h">{sec.skills.label}</h2>
          <span class="section__alias" aria-hidden="true">{sec.skills.alias}</span>
        </div>
        <div class="skills">
          {techSkills.map((g) => (
            <div class="skill-row">
              <h3>{g.heading}</h3>
              <ul class="chips">
                {g.items.map((s) => <li class="chip chip--lg">{s.charAt(0).toUpperCase() + s.slice(1)}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <!-- CONTACT -->
      <section class="section contact" id="contact" aria-labelledby="contact-h">
        <div class="section__head">
          <span class="section__num">{sec.contact.n}</span>
          <h2 id="contact-h">{sec.contact.label}</h2>
          <span class="section__alias" aria-hidden="true">{sec.contact.alias}</span>
        </div>
        <div class="contact__panel">
          <div>
            <p class="contact__lead">{targetRoles.length ? `Hiring for ${targetRoles.join(", ").replace(/, ([^,]*)$/, " or $1")}? Let's talk.` : "Let's talk."}</p>
            {emailLink && <a class="contact__email" href={emailLink.href}>{emailLink.value}</a>}
            <div class="cta-row cta-row--contact">
              {emailLink && <a class="btn btn--primary" href={emailLink.href}>Send an email <span aria-hidden="true">→</span></a>}
              <a class="btn" href={resumeHref} target="_blank" rel="noopener">Download CV <span class="btn__meta">PDF</span></a>
            </div>
          </div>
          <ul class="contact__list">
            {cv.contact.map((c) => (
              <li>
                <span class="contact__key">{c.label}</span>
                <a href={c.href} {...(c.href.startsWith("http") ? { target: "_blank", rel: "noopener" } : {})}>{c.value}</a>
              </li>
            ))}
            <li>
              <span class="contact__key">Résumé</span>
              <a href={resumeHref} target="_blank" rel="noopener">resume.pdf</a>
            </li>
          </ul>
        </div>
      </section>
    </main>

    <footer class="footer">
      <span>© {new Date().getFullYear()} {cv.name}</span>
      <a href="#top">Back to top ↑</a>
    </footer>

    <script>
      const root = document.documentElement;
      const btn = document.querySelector("[data-theme-toggle]");
      function apply(theme: string) {
        root.dataset.v3Theme = theme;
        btn?.setAttribute("aria-pressed", String(theme === "dark"));
      }
      apply(root.dataset.v3Theme || "light");
      btn?.addEventListener("click", () => {
        const next = root.dataset.v3Theme === "dark" ? "light" : "dark";
        localStorage.setItem("v3-theme", next);
        apply(next);
      });

      // Highlight the nav link for the section in view.
      const links = new Map(
        [...document.querySelectorAll<HTMLAnchorElement>("[data-nav]")].map((a) => [a.dataset.nav!, a]),
      );
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            links.forEach((a) => a.removeAttribute("aria-current"));
            links.get(e.target.id)?.setAttribute("aria-current", "true");
          }
        },
        { rootMargin: "-40% 0px -55% 0px" },
      );
      links.forEach((_, id) => {
        const el = document.getElementById(id);
        if (el) io.observe(el);
      });
    </script>

    <style is:global>
      html { scroll-behavior: smooth; }
      @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }

      body.v3 {
        --mono: "Space Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
        --sans: "Space Grotesk", system-ui, sans-serif;
        --bg: #fbfbfd;
        --surface: #ffffff;
        --text: #0e0e14;
        --text-2: #3d3d4a;
        --muted: #5f5f6e;
        --accent: #4338ca;
        --accent-ink: #ffffff;
        --accent-soft: rgba(67, 56, 202, 0.08);
        --accent-line: rgba(67, 56, 202, 0.22);
        --rule: #e6e6ee;
        --ok: #15803d;
        --shadow: 0 1px 2px rgba(16, 16, 40, 0.04), 0 8px 24px -12px rgba(16, 16, 40, 0.12);
        --radius: 14px;
        --maxw: 1120px;
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: var(--sans);
        font-size: 17px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
        transition: background-color 200ms ease, color 200ms ease;
      }
      html[data-v3-theme="dark"] body.v3 {
        --bg: #0a0a0f;
        --surface: #121219;
        --text: #f3f3f7;
        --text-2: #c9c9d6;
        --muted: #9a9aab;
        --accent: #9d94ff;
        --accent-ink: #0a0a0f;
        --accent-soft: rgba(157, 148, 255, 0.1);
        --accent-line: rgba(157, 148, 255, 0.28);
        --rule: #23232e;
        --ok: #4ade80;
        --shadow: 0 1px 2px rgba(0, 0, 0, 0.3), 0 8px 24px -12px rgba(0, 0, 0, 0.6);
      }
      .v3 *, .v3 *::before, .v3 *::after { box-sizing: border-box; }
      .v3 ::selection { background: var(--accent); color: var(--accent-ink); }
      .v3 a:focus-visible, .v3 button:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 3px;
        border-radius: 6px;
      }
      .v3 [id] { scroll-margin-top: 84px; }

      .v3 .skip-link {
        position: fixed; top: 12px; left: 12px; z-index: 100;
        padding: 0.6rem 1rem; font-family: var(--mono); font-size: 0.8rem;
        color: var(--accent-ink); background: var(--accent); text-decoration: none; border-radius: 8px;
        transform: translateY(-200%); transition: transform 150ms ease;
      }
      .v3 .skip-link:focus-visible { transform: translateY(0); }

      /* ---------- top bar ---------- */
      .v3 .topbar {
        position: sticky; top: 0; z-index: 50;
        background: color-mix(in srgb, var(--bg) 82%, transparent);
        backdrop-filter: saturate(160%) blur(12px);
        -webkit-backdrop-filter: saturate(160%) blur(12px);
        border-bottom: 1px solid var(--rule);
      }
      .v3 .topbar__inner {
        max-width: var(--maxw); margin: 0 auto; padding: 0 2rem; height: 64px;
        display: flex; align-items: center; gap: 1.5rem;
      }
      .v3 .brand {
        font-family: var(--mono); font-weight: 700; font-size: 0.95rem;
        color: var(--text); text-decoration: none; display: inline-flex; align-items: center;
      }
      .v3 .brand__prompt { color: var(--accent); }
      .v3 .brand__cursor {
        display: inline-block; width: 0.55em; height: 1.05em; margin-left: 2px;
        background: var(--accent); animation: blink 1.1s steps(1) infinite;
      }
      @keyframes blink { 50% { opacity: 0; } }
      @media (prefers-reduced-motion: reduce) { .v3 .brand__cursor { animation: none; } }
      .v3 .topnav { display: flex; gap: 0.25rem; margin-left: auto; }
      .v3 .topnav a {
        font-size: 0.9rem; font-weight: 500; color: var(--muted); text-decoration: none;
        padding: 0.4rem 0.75rem; border-radius: 999px;
        transition: color 150ms ease, background-color 150ms ease;
      }
      .v3 .topnav a:hover { color: var(--text); background: var(--accent-soft); }
      .v3 .topnav a[aria-current] { color: var(--accent); background: var(--accent-soft); }
      .v3 .theme-toggle {
        width: 40px; height: 40px; flex: none; display: inline-flex; align-items: center; justify-content: center;
        background: var(--surface); color: var(--text); border: 1px solid var(--rule); border-radius: 999px;
        cursor: pointer; padding: 0; transition: color 150ms ease, border-color 150ms ease;
      }
      .v3 .theme-toggle:hover { color: var(--accent); border-color: var(--accent); }
      .v3 .theme-toggle .icon { width: 18px; height: 18px; }
      .v3 .theme-toggle .icon--sun { display: none; }
      html[data-v3-theme="dark"] .v3 .theme-toggle .icon--sun { display: block; }
      html[data-v3-theme="dark"] .v3 .theme-toggle .icon--moon { display: none; }

      /* ---------- layout ---------- */
      .v3 main { max-width: var(--maxw); margin: 0 auto; padding: 0 2rem; }

      /* ---------- hero ---------- */
      .v3 .hero {
        position: relative;
        display: grid;
        grid-template-columns: minmax(0, 1fr) 300px;
        grid-template-areas: "text portrait" "facts facts";
        gap: 3rem 4rem;
        align-items: center;
        padding: 5.5rem 0 3.5rem;
      }
      .v3 .hero__grid-bg {
        position: absolute; inset: 0 -2rem; z-index: -1; pointer-events: none;
        background-image:
          linear-gradient(var(--rule) 1px, transparent 1px),
          linear-gradient(90deg, var(--rule) 1px, transparent 1px);
        background-size: 40px 40px;
        mask-image: radial-gradient(ellipse 70% 70% at 70% 30%, #000 10%, transparent 75%);
        -webkit-mask-image: radial-gradient(ellipse 70% 70% at 70% 30%, #000 10%, transparent 75%);
        opacity: 0.7;
      }
      .v3 .hero__text { grid-area: text; }
      .v3 .status {
        display: inline-flex; align-items: center; gap: 0.6rem; margin: 0 0 1.75rem;
        padding: 0.35rem 0.85rem 0.35rem 0.7rem;
        font-family: var(--mono); font-size: 0.78rem; color: var(--text-2);
        background: var(--surface); border: 1px solid var(--rule); border-radius: 999px;
      }
      .v3 .status__dot {
        width: 8px; height: 8px; border-radius: 50%; background: var(--ok);
        box-shadow: 0 0 0 0 color-mix(in srgb, var(--ok) 60%, transparent);
        animation: pulse 2s ease-out infinite;
      }
      @keyframes pulse { 70% { box-shadow: 0 0 0 8px transparent; } 100% { box-shadow: 0 0 0 0 transparent; } }
      @media (prefers-reduced-motion: reduce) { .v3 .status__dot { animation: none; } }
      .v3 h1 {
        font-size: clamp(2.6rem, 6.2vw, 4.75rem);
        line-height: 0.98; letter-spacing: -0.035em; font-weight: 700;
        margin: 0 0 1.25rem; text-wrap: balance;
      }
      .v3 .h1__last { color: var(--accent); }
      .v3 .hero__role {
        font-family: var(--mono); font-size: 0.95rem; letter-spacing: 0.12em; text-transform: uppercase;
        color: var(--text-2); margin: 0 0 1rem;
      }
      .v3 .hero__tagline {
        font-size: 1.2rem; line-height: 1.55; color: var(--text-2); max-width: 54ch; margin: 0 0 2.25rem;
        text-wrap: pretty;
      }
      .v3 .cta-row { display: flex; flex-wrap: wrap; gap: 0.75rem; }
      .v3 .btn {
        display: inline-flex; align-items: center; gap: 0.55rem;
        height: 46px; padding: 0 1.15rem; border-radius: 10px;
        font-size: 0.98rem; font-weight: 600; text-decoration: none;
        color: var(--text); background: var(--surface); border: 1px solid var(--rule);
        transition: transform 150ms ease, border-color 150ms ease, background-color 150ms ease, color 150ms ease, box-shadow 150ms ease;
      }
      .v3 .btn svg { width: 18px; height: 18px; flex: none; }
      .v3 .btn:hover { border-color: var(--accent); color: var(--accent); transform: translateY(-1px); }
      .v3 .btn--primary { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); box-shadow: 0 6px 20px -8px var(--accent); }
      .v3 .btn--primary:hover { color: var(--accent-ink); filter: brightness(1.08); }
      .v3 .btn__meta { font-family: var(--mono); font-size: 0.7rem; font-weight: 400; opacity: 0.75; }

      .v3 .portrait { grid-area: portrait; margin: 0; justify-self: end; width: 100%; }
      .v3 .portrait__frame {
        position: relative; padding: 8px; border: 1px solid var(--accent-line);
        background: var(--surface); border-radius: 4px; box-shadow: var(--shadow);
      }
      .v3 .portrait__frame img { display: block; width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; }
      .v3 .corner { position: absolute; width: 14px; height: 14px; border: 2px solid var(--accent); }
      .v3 .corner--tl { top: -1px; left: -1px; border-right: 0; border-bottom: 0; }
      .v3 .corner--tr { top: -1px; right: -1px; border-left: 0; border-bottom: 0; }
      .v3 .corner--bl { bottom: -1px; left: -1px; border-right: 0; border-top: 0; }
      .v3 .corner--br { bottom: -1px; right: -1px; border-left: 0; border-top: 0; }
      .v3 .portrait__caption {
        display: flex; justify-content: space-between; margin-top: 0.7rem;
        font-family: var(--mono); font-size: 0.72rem; color: var(--muted);
      }
      .v3 .portrait__ok { color: var(--ok); }

      .v3 .facts {
        grid-area: facts; margin: 0;
        display: grid; grid-template-columns: repeat(4, minmax(0, 1fr));
        border: 1px solid var(--rule); border-radius: var(--radius); background: var(--surface);
        box-shadow: var(--shadow);
      }
      .v3 .fact { padding: 1.1rem 1.35rem; border-left: 1px solid var(--rule); }
      .v3 .fact:first-child { border-left: 0; }
      .v3 .fact dt {
        font-family: var(--mono); font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase;
        color: var(--accent); margin-bottom: 0.3rem;
      }
      .v3 .fact dd { margin: 0; font-weight: 500; font-size: 0.95rem; line-height: 1.4; }

      .v3 .portrait { position: relative; }
      .v3 .topo { position: absolute; z-index: -1; left: -50px; top: -50px; width: calc(100% + 100px); height: auto; aspect-ratio: 400 / 520; pointer-events: none; overflow: visible; }
      .v3 .topo__links path { fill: none; stroke: var(--accent-line); stroke-width: 1.25; stroke-dasharray: 4 5; }
      .v3 .topo__packets circle { fill: var(--accent); }
      .v3 .topo__nodes rect { fill: var(--surface); stroke: var(--accent-line); stroke-width: 1.25; }
      .v3 .topo__nodes text { font-family: var(--mono); font-size: 9px; text-anchor: middle; fill: var(--accent); font-weight: 700; }
      @media (prefers-reduced-motion: reduce) { .v3 .topo__packets { display: none; } }

      .v3 .targets { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.75rem; margin: -1rem 0 2.25rem; }
      .v3 .targets__label { font-family: var(--mono); font-size: 0.78rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
      .v3 .targets ul { display: contents; list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.4rem; }
      .v3 .targets li {
        font-size: 0.9rem; font-weight: 600; color: var(--accent);
        padding: 0.3rem 0.7rem; border-radius: 999px; background: var(--accent-soft); border: 1px solid var(--accent-line);
      }

      .v3 .metric { color: var(--text); font-weight: 700; background: linear-gradient(transparent 62%, var(--accent-soft) 62%); }

      .v3 .more { margin-top: 0.55rem; }
      .v3 .more > summary {
        list-style: none; cursor: pointer; display: inline-flex; align-items: center; gap: 0.4rem;
        font-family: var(--mono); font-size: 0.8rem; color: var(--accent); padding: 0.25rem 0;
      }
      .v3 .more > summary::-webkit-details-marker { display: none; }
      .v3 .more > summary::before { content: "+"; font-weight: 700; width: 1rem; text-align: center; }
      .v3 .more[open] > summary::before { content: "\2212"; }
      .v3 .more .more__close, .v3 .more[open] .more__open { display: none; }
      .v3 .more[open] .more__close { display: inline; }
      .v3 .more[open] > summary { margin-bottom: 0.55rem; }
      .v3 .more > summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 4px; }

      /* ---------- about ---------- */
      .v3 .about { padding: 2.5rem 0 1rem; max-width: 760px; }
      .v3 .about__label { font-family: var(--mono); font-size: 0.8rem; color: var(--accent); margin: 0 0 0.75rem; }
      .v3 .about__text { font-size: 1.15rem; line-height: 1.75; color: var(--text-2); margin: 0; text-wrap: pretty; }

      /* ---------- sections ---------- */
      .v3 .section { padding: 5rem 0 0; }
      .v3 .section__head {
        display: flex; align-items: center; gap: 0.9rem;
        padding-bottom: 1rem; margin-bottom: 2.5rem; border-bottom: 1px solid var(--rule);
      }
      .v3 .section__num {
        font-family: var(--mono); font-size: 0.78rem; color: var(--accent); font-weight: 700;
        padding: 0.2rem 0.45rem; border: 1px solid var(--accent-line); border-radius: 6px; background: var(--accent-soft);
      }
      .v3 .section__num::before { content: "0x"; opacity: 0.6; }
      .v3 h2 { font-size: clamp(1.75rem, 3vw, 2.25rem); letter-spacing: -0.02em; line-height: 1.1; margin: 0; font-weight: 700; }
      .v3 .section__alias { margin-left: auto; font-family: var(--mono); font-size: 0.75rem; color: var(--muted); }
      .v3 .section__alias::before { content: "// "; color: var(--accent); }

      .v3 h3 { font-size: 1.25rem; line-height: 1.3; letter-spacing: -0.01em; font-weight: 600; margin: 0 0 0.35rem; text-wrap: balance; }
      .v3 .org { margin: 0 0 1rem; color: var(--muted); font-size: 0.95rem; }
      .v3 .org strong { color: var(--text-2); font-weight: 600; }
      .v3 .org__sep { margin: 0 0.25rem; }
      .v3 .desc { margin: 0 0 1rem; color: var(--text-2); max-width: 70ch; }
      .v3 .desc--sm { font-size: 0.95rem; }

      .v3 .bullets { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.55rem; }
      .v3 .bullets li { position: relative; padding-left: 1.4rem; color: var(--text-2); font-size: 0.98rem; line-height: 1.6; max-width: 72ch; }
      .v3 .bullets li::before {
        content: ""; position: absolute; left: 0.2rem; top: 0.68em;
        width: 6px; height: 6px; border: 1.5px solid var(--accent); transform: rotate(45deg);
      }

      /* timeline */
      .v3 .timeline { list-style: none; margin: 0; padding: 0; position: relative; }
      .v3 .tl-item { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 2.5rem; position: relative; padding-bottom: 3rem; }
      .v3 .tl-item:last-child { padding-bottom: 0; }
      .v3 .tl-item__body { position: relative; padding-left: 2rem; border-left: 1px solid var(--rule); }
      .v3 .tl-item:last-child .tl-item__body { border-left-color: transparent; }
      .v3 .tl-item__body::before {
        content: ""; position: absolute; left: -6px; top: 0.45rem;
        width: 11px; height: 11px; border-radius: 50%;
        background: var(--bg); border: 2px solid var(--accent);
      }
      .v3 .tl-item:first-child .tl-item__body::before { background: var(--accent); box-shadow: 0 0 0 4px var(--accent-soft); }
      .v3 .tl-item__period { display: block; padding-top: 0.25rem; font-family: var(--mono); font-size: 0.78rem; color: var(--muted); line-height: 1.5; }
      .v3 .timeline--compact .tl-item { grid-template-columns: 1fr; gap: 0.35rem; padding-bottom: 2rem; }
      .v3 .timeline--compact .tl-item__meta { padding-left: 2rem; order: 0; }
      .v3 .timeline--compact .tl-item { border-left: 1px solid var(--rule); }
      .v3 .timeline--compact .tl-item:last-child { border-left-color: transparent; }
      .v3 .timeline--compact .tl-item__body { border-left: 0; }
      .v3 .timeline--compact .tl-item__body::before { display: none; }
      .v3 .timeline--compact .tl-item::before {
        content: ""; position: absolute; left: -6px; top: 0.4rem;
        width: 11px; height: 11px; border-radius: 50%; background: var(--bg); border: 2px solid var(--accent);
      }
      .v3 .timeline--compact .tl-item__period { padding-top: 0; }
      .v3 .timeline--compact h3 { font-size: 1.1rem; }

      /* cards */
      .v3 .card {
        position: relative; background: var(--surface); border: 1px solid var(--rule);
        border-radius: var(--radius); padding: 1.75rem; box-shadow: var(--shadow);
        transition: border-color 200ms ease, transform 200ms ease;
      }
      .v3 .card:hover { border-color: var(--accent-line); }
      .v3 .card__date { display: block; font-family: var(--mono); font-size: 0.78rem; color: var(--muted); margin-bottom: 0.6rem; }
      .v3 .projects { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; }
      .v3 .project { display: flex; flex-direction: column; }
      .v3 .project h3 { margin-bottom: 0.9rem; }
      .v3 .project .bullets { margin-bottom: 1.5rem; }
      .v3 .project__foot { margin-top: auto; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; padding-top: 1.25rem; border-top: 1px dashed var(--rule); }
      .v3 .project--featured { grid-column: 1 / -1; padding: 2.25rem; border-color: var(--accent-line); }
      .v3 .project--featured::before {
        content: ""; position: absolute; left: -1px; top: 24px; bottom: 24px; width: 3px; background: var(--accent); border-radius: 3px;
      }
      .v3 .project--featured h3 { font-size: 1.55rem; max-width: 34ch; }
      .v3 .project--featured .bullets { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.8rem 2.5rem; }
      .v3 .project__flag {
        align-self: flex-start; margin-bottom: 0.9rem;
        font-family: var(--mono); font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase;
        color: var(--accent); background: var(--accent-soft); padding: 0.25rem 0.6rem; border-radius: 6px;
      }

      .v3 .chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.45rem; }
      .v3 .chip {
        font-family: var(--mono); font-size: 0.78rem; line-height: 1; color: var(--text-2);
        padding: 0.45rem 0.6rem; border: 1px solid var(--rule); border-radius: 6px; background: var(--bg);
      }
      .v3 .chip--lg { font-family: var(--sans); font-size: 0.9rem; font-weight: 500; padding: 0.5rem 0.75rem; }

      .v3 .text-link {
        font-family: var(--mono); font-size: 0.8rem; color: var(--accent); text-decoration: none;
        border-bottom: 1px solid var(--accent-line); padding-bottom: 1px; overflow-wrap: anywhere;
      }
      .v3 .text-link:hover { border-bottom-color: var(--accent); }

      /* education / certs */
      .v3 .edu-split { display: grid; grid-template-columns: 1.15fr 1fr; gap: 3.5rem; align-items: start; }
      .v3 .sub-h {
        font-family: var(--mono); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase;
        color: var(--muted); margin: 0 0 1.5rem;
      }
      .v3 .certs { display: grid; gap: 1.25rem; }
      .v3 .cert { padding: 1.5rem; }
      .v3 .cert__head { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; }
      .v3 .cert h3 { font-size: 1.1rem; }
      .v3 .cert .org { margin-bottom: 0.75rem; }
      .v3 .cert__badge { flex: none; display: block; }
      .v3 .cert__badge img { display: block; width: 72px; height: 72px; transition: transform 200ms ease; }
      .v3 .cert__badge:hover img { transform: scale(1.05); }

      /* skills */
      .v3 .skills { border: 1px solid var(--rule); border-radius: var(--radius); background: var(--surface); box-shadow: var(--shadow); overflow: hidden; }
      .v3 .skill-row { display: grid; grid-template-columns: 240px minmax(0, 1fr); gap: 1.5rem; align-items: center; padding: 1.1rem 1.5rem; border-top: 1px solid var(--rule); }
      .v3 .skill-row:first-child { border-top: 0; }
      .v3 .skill-row h3 {
        font-family: var(--mono); font-size: 0.75rem; letter-spacing: 0.12em; text-transform: uppercase;
        color: var(--accent); font-weight: 700; margin: 0;
      }

      /* contact */
      .v3 .contact__panel {
        display: grid; grid-template-columns: 1.2fr 1fr; gap: 3rem; align-items: center;
        padding: 2.5rem; border-radius: calc(var(--radius) + 4px);
        background:
          radial-gradient(120% 140% at 0% 0%, var(--accent-soft), transparent 60%),
          var(--surface);
        border: 1px solid var(--accent-line); box-shadow: var(--shadow);
      }
      .v3 .contact__lead { font-size: 1.5rem; line-height: 1.3; font-weight: 600; letter-spacing: -0.015em; margin: 0 0 1.25rem; max-width: 26ch; text-wrap: balance; }
      .v3 .cta-row--contact { margin-top: 1.75rem; }
      .v3 .contact__email {
        font-family: var(--mono); font-size: clamp(0.95rem, 2vw, 1.15rem); font-weight: 700; color: var(--accent);
        text-decoration: none; border-bottom: 2px solid var(--accent-line); overflow-wrap: anywhere;
      }
      .v3 .contact__email:hover { border-bottom-color: var(--accent); }
      .v3 .contact__list { list-style: none; margin: 0; padding: 0; display: grid; }
      .v3 .contact__list li { display: grid; grid-template-columns: 90px minmax(0, 1fr); gap: 1rem; padding: 0.8rem 0; border-bottom: 1px solid var(--rule); align-items: baseline; }
      .v3 .contact__list li:last-child { border-bottom: 0; }
      .v3 .contact__key { font-family: var(--mono); font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
      .v3 .contact__list a { color: var(--text); text-decoration: none; font-weight: 500; overflow-wrap: anywhere; }
      .v3 .contact__list a:hover { color: var(--accent); }

      .v3 .footer {
        max-width: var(--maxw); margin: 5rem auto 0; padding: 2rem; border-top: 1px solid var(--rule);
        display: flex; justify-content: space-between; gap: 1rem;
        font-family: var(--mono); font-size: 0.78rem; color: var(--muted);
      }
      .v3 .footer a { color: var(--muted); text-decoration: none; }
      .v3 .footer a:hover { color: var(--accent); }

      /* ---------- responsive ---------- */
      @media (max-width: 960px) {
        .v3 .topnav a { padding: 0.4rem 0.55rem; font-size: 0.85rem; }
        .v3 .facts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .v3 .fact:nth-child(3) { border-left: 0; }
        .v3 .fact:nth-child(n + 3) { border-top: 1px solid var(--rule); }
        .v3 .edu-split { grid-template-columns: 1fr; }
        .v3 .project--featured .bullets { grid-template-columns: 1fr; }
      }
      @media (max-width: 760px) {
        body.v3 { font-size: 16px; }
        .v3 main { padding: 0 1.25rem; }
        .v3 .topbar__inner { padding: 0 1.25rem; height: auto; min-height: 56px; flex-wrap: wrap; gap: 0 1rem; }
        .v3 .theme-toggle { margin-left: auto; width: 36px; height: 36px; }
        .v3 .topnav {
          order: 3; flex-basis: 100%; margin: 0 -1.25rem; padding: 0 1rem 0.6rem;
          overflow-x: auto; scrollbar-width: none;
        }
        .v3 .topnav::-webkit-scrollbar { display: none; }
        .v3 .topnav a { white-space: nowrap; padding: 0.35rem 0.55rem; font-size: 0.84rem; }
        .v3 .topnav { mask-image: linear-gradient(90deg, #000 85%, transparent); -webkit-mask-image: linear-gradient(90deg, #000 85%, transparent); padding-right: 2.5rem; }
        .v3 [id] { scroll-margin-top: 110px; }
        .v3 .hero {
          grid-template-columns: minmax(0, 1fr) 92px;
          grid-template-areas: none;
          gap: 1.25rem 1rem; padding: 2rem 0 2rem; align-items: start;
        }
        .v3 .topo { display: none; }
        .v3 .hero__text { display: contents; }
        .v3 .status { grid-area: auto; grid-row: 1; grid-column: 1 / -1; justify-self: start; margin: 0; font-size: 0.75rem; }
        .v3 .hero__text > h1 { grid-row: 2; grid-column: 1; align-self: center; margin: 0; font-size: 2.35rem; }
        .v3 .portrait { grid-area: auto; grid-row: 2; grid-column: 2; align-self: center; }
        .v3 .facts { grid-area: auto; grid-column: 1 / -1; }
        .v3 .hero__text > :not(.status):not(h1) { grid-column: 1 / -1; }
        .v3 .targets { margin: 0; }
        .v3 h1 { margin-bottom: 0.75rem; }
        .v3 .hero__tagline { font-size: 1.05rem; margin: 0; }
        .v3 .portrait__frame { padding: 4px; }
        .v3 .portrait__caption { display: none; }
        .v3 .corner { width: 10px; height: 10px; }
        .v3 .btn { height: 44px; padding: 0 0.95rem; font-size: 0.93rem; }
        .v3 .btn--primary { flex-basis: 100%; justify-content: center; }
        .v3 .cta-row .btn:not(.btn--primary) { flex: 1; justify-content: center; }
        .v3 .facts { grid-template-columns: 1fr 1fr; }
        .v3 .fact { padding: 0.9rem 1rem; }
        .v3 .section { padding-top: 3.5rem; }
        .v3 .section__alias { display: none; }
