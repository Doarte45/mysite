---
import BaseHead from "../layouts/BaseHead.astro";
import { cv } from "../data/cv.ts";

const homeUrl = `${import.meta.env.BASE_URL}/`.replace(/\/+/g, "/");
---

<html lang="en">
  <head>
    <BaseHead
      title={`404 — ${cv.name}`}
      description="Page not found."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;700&family=Space+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("v3-theme");
          var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          var theme = stored || (prefersDark ? "dark" : "light");
          document.documentElement.dataset.v3Theme = theme;
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="v3">
    <main>
      <div class="network-tag">PACKET_LOST</div>
      <h1>404</h1>
      <p class="desc">
        Destination host unreachable. The route you requested does not exist.
      </p>
      <a class="home-btn" href={homeUrl}>
        <span class="home-btn__bracket">[</span>
        <span class="home-btn__label">RETURN_TO_ORIGIN</span>
        <span class="home-btn__arrow">→</span>
        <span class="home-btn__bracket">]</span>
      </a>
    </main>

    <style is:global>
      body.v3 {
        --mono: "Space Mono", ui-monospace, monospace;
        --bg: #ffffff;
        --text: #000000;
        --accent: #4338ca;
        background-color: var(--bg);
        color: var(--text);
        font-family: "Space Grotesk", sans-serif;
        min-height: 100vh;
        margin: 0;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      html[data-v3-theme="dark"] body.v3 {
        --bg: #0b0b10;
        --text: #f5f5f7;
        --accent: #8b80ff;
      }

      .v3 main {
        text-align: center;
        padding: 2rem;
      }

      .v3 .network-tag {
        font-family: var(--mono);
        font-size: 0.65rem;
        letter-spacing: 0.4em;
        background: var(--accent);
        color: white;
        display: inline-block;
        padding: 0.2rem 0.6rem;
        margin-bottom: 1.5rem;
      }

      .v3 h1 {
        font-size: clamp(4rem, 15vw, 8rem);
        line-height: 1;
        font-weight: 700;
        letter-spacing: -0.04em;
        margin: 0 0 1rem;
      }

      .v3 .desc {
        font-family: var(--mono);
        font-size: 0.9rem;
        opacity: 0.7;
        margin: 0 0 2.5rem;
      }

      .v3 .home-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.65rem;
        padding: 0.65rem 1.1rem;
        font-family: var(--mono);
        font-size: 0.85rem;
        letter-spacing: 0.08em;
        color: var(--accent);
        text-decoration: none;
        border: 1px solid var(--accent);
        transition: background-color 0.15s ease, color 0.15s ease;
      }
      .v3 .home-btn__bracket {
        opacity: 0.6;
      }
      .v3 .home-btn:hover {
        background: var(--accent);
        color: var(--bg);
      }
      .v3 .home-btn:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }
    </style>
  </body>
</html>
